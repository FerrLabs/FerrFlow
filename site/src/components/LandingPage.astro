---
import { t, getLocalizedPath } from '../i18n/translations';
import type { Lang } from '../i18n/translations';
import SharedNavbar from './Navbar.astro';
import SharedFooter from './Footer.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const docsPath = getLocalizedPath('/docs/introduction', lang);

const currentPath = Astro.url.pathname;
const enEquiv =
  currentPath.startsWith('/fr/') ? currentPath.slice(3) || '/'
  : currentPath === '/fr' ? '/'
  : currentPath;
const frEquiv = enEquiv === '/' ? '/fr/' : `/fr${enEquiv.startsWith('/') ? '' : '/'}${enEquiv}`;

const installs = [
  { key: t(lang, 'cliPage.install.cargo'), cmd: 'cargo install ferrflow' },
  { key: t(lang, 'cliPage.install.npm'),   cmd: 'npm install -D ferrflow' },
  { key: t(lang, 'cliPage.install.brew'),  cmd: 'brew install ferrlabs/tap/ferrflow' },
  { key: t(lang, 'cliPage.install.docker'),cmd: 'docker run ghcr.io/ferrlabs/ferrflow' },
];

const features = [
  { title: t(lang, 'cliPage.features.versioning.title'), desc: t(lang, 'cliPage.features.versioning.desc') },
  { title: t(lang, 'cliPage.features.monorepo.title'),   desc: t(lang, 'cliPage.features.monorepo.desc') },
  { title: t(lang, 'cliPage.features.forge.title'),      desc: t(lang, 'cliPage.features.forge.desc') },
  { title: t(lang, 'cliPage.features.formats.title'),    desc: t(lang, 'cliPage.features.formats.desc') },
  { title: t(lang, 'cliPage.features.changelog.title'),  desc: t(lang, 'cliPage.features.changelog.desc') },
  { title: t(lang, 'cliPage.features.opensource.title'), desc: t(lang, 'cliPage.features.opensource.desc') },
];

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'FerrFlow',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  url: 'https://ferrflow.com',
  downloadUrl: 'https://github.com/FerrLabs/FerrFlow/releases/latest',
  description: t(lang, 'cliPage.meta.description'),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'FerrLabs', url: 'https://ferrlabs.com' },
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />

<SharedNavbar lang={lang} enEquiv={enEquiv} frEquiv={frEquiv} />

<main class="marketing">
  <section class="hero">
    <div class="container narrow">
      <h1 class="display">
        {t(lang, 'cliPage.hero.headline1')} {t(lang, 'cliPage.hero.headline2')}
      </h1>
      <p class="lede">{t(lang, 'cliPage.hero.subheading')}</p>
      <div class="cta-row">
        <a href="https://github.com/FerrLabs/FerrFlow/releases/latest" class="btn btn-primary">{t(lang, 'cliPage.hero.download')}</a>
        <a href={docsPath} class="btn btn-secondary">{t(lang, 'cliPage.hero.docs')}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t(lang, 'cliPage.install.eyebrow')}</p>
        <h2 class="section-title">{t(lang, 'cliPage.install.title')}</h2>
        <p class="section-sub">{t(lang, 'cliPage.install.subtitle')}</p>
      </div>
      <div class="card-grid card-grid-2">
        {installs.map((i) => (
          <div class="install-card">
            <div class="install-head">{i.key}</div>
            <div class="codeblock">
              <pre class="code"><span class="prompt">$</span><code>{i.cmd}</code></pre>
              <button class="copy-btn" type="button" data-copy={i.cmd} aria-label="Copy">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                </svg>
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t(lang, 'cliPage.features.eyebrow')}</p>
        <h2 class="section-title">{t(lang, 'cliPage.features.title')}</h2>
        <p class="section-sub">{t(lang, 'cliPage.features.subtitle')}</p>
      </div>
      <div class="card-grid card-grid-3">
        {features.map((f) => (
          <div class="feature-card">
            <div class="feature-icon" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12" />
              </svg>
            </div>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="cta-card">
        <p class="eyebrow">{t(lang, 'cliPage.cta.eyebrow')}</p>
        <h2 class="cta-title">{t(lang, 'cta.title1')} {t(lang, 'cta.title2')}</h2>
        <p class="cta-sub">{t(lang, 'cta.subtitle')}</p>
        <div class="cta-row">
          <a href="https://github.com/FerrLabs/FerrFlow" class="btn btn-primary">{t(lang, 'cta.button')}</a>
          <a href="#install" class="btn btn-secondary">{t(lang, 'cliPage.cta.install')}</a>
        </div>
      </div>
    </div>
  </section>
</main>

<SharedFooter />

<script is:inline>
  document.querySelectorAll('button.copy-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var text = btn.getAttribute('data-copy') || '';
      if (!text) return;
      var ok = function () {
        btn.classList.add('copied');
        setTimeout(function () { btn.classList.remove('copied'); }, 1200);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(ok).catch(function () {});
      } else {
        try {
          var ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          ok();
        } catch (e) {}
      }
    });
  });
</script>

<style is:global>
  :root {
    --bg: #fafafa;
    --text: #18181b;
    --text-muted: #52525b;
    --hairline: #e4e4e7;
    --accent: #e8733a;
    --accent-strong: #c85a2c;
    --card: #ffffff;
    --code-bg: #1c1c1c;
    --code-bg-header: #161616;
    --code-fg: #e6e6e6;
  }
  :root[data-theme='dark'] {
    --bg: #0a0a0a;
    --text: #e4e4e7;
    --text-muted: #a1a1aa;
    --hairline: #27272a;
    --accent: #ef8a55;
    --accent-strong: #ffb07a;
    --card: #18181b;
  }
  html, body {
    background: var(--bg);
    color: var(--text);
    font-family:
      'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    font-feature-settings: 'cv11', 'ss01', 'ss03';
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  ::selection { background: var(--accent); color: #fff; }
</style>

<style>
  .marketing { color: var(--text); }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
  .container.narrow { max-width: 760px; }
  @media (max-width: 720px) { .container { padding: 0 20px; } }

  .eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 12px;
  }

  .hero {
    padding: 96px 0 72px;
    text-align: center;
  }
  .display {
    font-family: inherit;
    font-weight: 600;
    font-size: clamp(40px, 6vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--text);
    margin: 0 0 24px;
    text-wrap: balance;
  }
  .lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0 auto 40px;
    max-width: 640px;
    text-wrap: pretty;
  }

  .cta-row {
    display: inline-flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    border: 1px solid transparent;
    text-decoration: none;
    cursor: pointer;
    transition: transform 150ms ease, background 150ms ease, border-color 150ms ease, color 150ms ease;
  }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { background: var(--accent-strong); transform: translateY(-1px); }
  .btn-secondary { background: transparent; color: var(--text); border-color: var(--hairline); }
  .btn-secondary:hover { border-color: var(--text-muted); transform: translateY(-1px); }

  .section { padding: 64px 0; border-top: 1px solid var(--hairline); }
  .section:first-of-type { border-top: none; }
  .section-alt { background: transparent; }
  .section-head {
    text-align: center;
    margin: 0 auto 40px;
    max-width: 640px;
  }
  .section-title {
    font-family: inherit;
    font-weight: 600;
    font-size: clamp(28px, 3.5vw, 36px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 12px;
  }
  .section-sub {
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }

  .card-grid {
    display: grid;
    gap: 16px;
  }
  .card-grid-2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .card-grid-3 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  @media (max-width: 720px) {
    .card-grid-2, .card-grid-3 { grid-template-columns: 1fr; }
  }

  .install-card {
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 150ms ease, border-color 150ms ease;
  }
  .install-card:hover { transform: translateY(-1px); border-color: var(--text-muted); }
  .install-head {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.005em;
  }
  .codeblock {
    position: relative;
    background: var(--code-bg);
    border-radius: 8px;
    padding: 10px 12px;
    overflow: hidden;
  }
  .code {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, 'DM Mono', Menlo, Consolas, monospace;
    font-size: 13px;
    line-height: 1.5;
    color: var(--code-fg);
    white-space: pre;
    overflow-x: auto;
    padding-right: 28px;
  }
  .prompt { color: var(--accent); margin-right: 6px; user-select: none; }
  .copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: #a1a1aa;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .codeblock:hover .copy-btn { opacity: 1; }
  .copy-btn:hover { color: #fff; border-color: #404040; }
  .copy-btn.copied { color: var(--accent); border-color: var(--accent); opacity: 1; }

  .feature-card {
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform 150ms ease, border-color 150ms ease;
  }
  .feature-card:hover { transform: translateY(-1px); border-color: var(--text-muted); }
  .feature-icon {
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background: color-mix(in oklab, var(--accent) 15%, transparent);
    color: var(--accent);
    margin-bottom: 4px;
  }
  .feature-title {
    font-family: inherit;
    font-weight: 600;
    font-size: 16px;
    color: var(--text);
    margin: 0;
    letter-spacing: -0.01em;
  }
  .feature-desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }

  .cta-card {
    background: var(--card);
    border: 1px solid var(--hairline);
    border-radius: 16px;
    padding: 48px 32px;
    text-align: center;
  }
  .cta-card .eyebrow { margin-bottom: 16px; }
  .cta-title {
    font-family: inherit;
    font-weight: 600;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 12px;
  }
  .cta-sub {
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 520px;
    margin: 0 auto 28px;
  }
</style>
