---
import { t, getLocalizedPath } from '../i18n/translations';
import type { Lang } from '../i18n/translations';
import Navbar from './Navbar.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const docsPath = getLocalizedPath('/docs/introduction', lang);
const ghActionsPath = getLocalizedPath('/docs/ci/github-actions', lang);
const glCiPath = getLocalizedPath('/docs/ci/gitlab-ci', lang);
---

<header class="landing-header"><div class="landing-header-inner"><Navbar lang={lang} activePage="home" /></div></header>

<!-- Hero -->
<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[600px] rounded-full opacity-40" style="background: radial-gradient(ellipse, #FFCBA4 0%, #FFE8D2 40%, transparent 70%);"></div>
  <div class="relative max-w-5xl mx-auto px-6 pt-24 pb-16">
    <div class="flex items-center justify-center gap-2 mb-6">
      <span class="px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-medium">{t(lang, 'cliPage.hero.badge')}</span>
    </div>
    <h1 class="text-center font-black text-primary-950 tracking-tight leading-[0.95]">
      <span class="block text-7xl sm:text-8xl md:text-[7rem] lg:text-[8.5rem]">{t(lang, 'cliPage.hero.headline1')}</span>
      <span class="block text-7xl sm:text-8xl md:text-[7rem] lg:text-[8.5rem] italic text-primary-600">{t(lang, 'cliPage.hero.headline2')}</span>
    </h1>
    <p class="mt-8 text-center text-lg sm:text-xl text-primary-700 max-w-2xl mx-auto leading-relaxed">
      {t(lang, 'cliPage.hero.subheading')}
    </p>
    <div class="mt-8 flex gap-3 justify-center">
      <a href="https://github.com/FerrLabs/FerrFlow/releases/latest" class="px-7 py-3 rounded-full bg-primary-600 text-white font-medium hover:bg-primary-700 transition-colors shadow-lg shadow-primary-200">{t(lang, 'cliPage.hero.download')}</a>
      <a href={docsPath} class="px-7 py-3 rounded-full border border-primary-300 text-primary-800 font-medium hover:bg-primary-100 transition-colors">{t(lang, 'cliPage.hero.docs')}</a>
    </div>
  </div>
</section>

<!-- Terminal -->
<section class="pb-20">
  <div class="max-w-2xl mx-auto px-6">
    <div class="rounded-2xl overflow-hidden shadow-xl shadow-primary-200/60 border border-primary-200">
      <div class="bg-primary-950 px-4 py-3 flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-red-400/70"></span>
        <span class="w-3 h-3 rounded-full bg-yellow-400/70"></span>
        <span class="w-3 h-3 rounded-full bg-green-400/70"></span>
        <span class="ml-3 text-xs text-primary-400 font-mono">ferrflow</span>
      </div>
      <div class="bg-primary-950 px-5 py-5 font-mono text-sm leading-7">
        <p><span class="text-primary-400">$ </span><span class="text-primary-100">ferrflow check</span></p>
        <p class="text-primary-500">{t(lang, 'cliPage.terminal.scanning')}</p>
        <p><span class="text-primary-500">{t(lang, 'cliPage.terminal.bump')}</span><span class="text-primary-200">api</span><span class="text-primary-500"> 1.5.0 &rarr; </span><span class="text-green-400 font-medium">1.6.0</span></p>
        <p><span class="text-primary-500">{t(lang, 'cliPage.terminal.bump')}</span><span class="text-primary-200">web</span><span class="text-primary-500"> 0.4.2 &rarr; </span><span class="text-green-400 font-medium">0.5.0</span></p>
        <p class="mt-3"><span class="text-primary-400">$ </span><span class="text-primary-100">ferrflow release</span></p>
        <p class="text-primary-500">{t(lang, 'cliPage.terminal.generating')}</p>
        <p><span class="text-primary-500">{t(lang, 'cliPage.terminal.tag')}</span><span class="text-primary-200">api@v1.6.0</span><span class="text-green-400 ml-2">&check;</span></p>
        <p><span class="text-primary-500">{t(lang, 'cliPage.terminal.tag')}</span><span class="text-primary-200">web@v0.5.0</span><span class="text-green-400 ml-2">&check;</span></p>
        <p><span class="text-primary-500">{t(lang, 'cliPage.terminal.released')}</span></p>
      </div>
    </div>
  </div>
</section>

<!-- What's inside -->
<section class="py-20 bg-white border-t border-primary-100">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-14">
      <h2 class="text-3xl sm:text-4xl font-black text-primary-950 tracking-tight">{t(lang, 'cliPage.features.title')}</h2>
      <p class="mt-3 text-primary-600">{t(lang, 'cliPage.features.subtitle')}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
      <div class="flex gap-4">
        <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z" /></svg>
        </div>
        <div>
          <h3 class="font-bold text-primary-950 text-lg">{t(lang, 'cliPage.features.versioning.title')}</h3>
          <p class="mt-1 text-sm text-primary-700 leading-relaxed">{t(lang, 'cliPage.features.versioning.desc')}</p>
        </div>
      </div>
      <div class="flex gap-4">
        <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        </div>
        <div>
          <h3 class="font-bold text-primary-950 text-lg">{t(lang, 'cliPage.features.monorepo.title')}</h3>
          <p class="mt-1 text-sm text-primary-700 leading-relaxed">{t(lang, 'cliPage.features.monorepo.desc')}</p>
        </div>
      </div>
      <div class="flex gap-4">
        <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        </div>
        <div>
          <h3 class="font-bold text-primary-950 text-lg">{t(lang, 'cliPage.features.changelog.title')}</h3>
          <p class="mt-1 text-sm text-primary-700 leading-relaxed">{t(lang, 'cliPage.features.changelog.desc')}</p>
        </div>
      </div>
      <div class="flex gap-4">
        <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
        </div>
        <div>
          <h3 class="font-bold text-primary-950 text-lg">{t(lang, 'cliPage.features.forge.title')}</h3>
          <p class="mt-1 text-sm text-primary-700 leading-relaxed">{t(lang, 'cliPage.features.forge.desc')}</p>
        </div>
      </div>
      <div class="flex gap-4">
        <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
        </div>
        <div>
          <h3 class="font-bold text-primary-950 text-lg">{t(lang, 'cliPage.features.formats.title')}</h3>
          <p class="mt-1 text-sm text-primary-700 leading-relaxed">{t(lang, 'cliPage.features.formats.desc')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Install -->
<section class="py-20 bg-primary-50 border-t border-primary-100">
  <div class="max-w-2xl mx-auto px-6 text-center">
    <h2 class="text-3xl sm:text-4xl font-black text-primary-950 tracking-tight mb-8">{t(lang, 'cliPage.install.title')}</h2>
    <div class="rounded-2xl overflow-hidden border border-primary-200 shadow-lg shadow-primary-200/40 text-left">
      <div class="bg-primary-950 px-5 py-5 font-mono text-sm leading-7">
        <p class="text-primary-500"># macOS / Linux</p>
        <p><span class="text-primary-400">$ </span><span class="text-primary-100">curl -fsSL https://ferrflow.com/install.sh | sh</span></p>
        <p class="text-primary-500 mt-4"># npm</p>
        <p><span class="text-primary-400">$ </span><span class="text-primary-100">npm install -g ferrflow</span></p>
        <p class="text-primary-500 mt-4"># Docker</p>
        <p><span class="text-primary-400">$ </span><span class="text-primary-100">docker run ghcr.io/ferrlabs/ferrflow check</span></p>
      </div>
    </div>
    <p class="mt-6 text-sm text-primary-600">{t(lang, 'cliPage.install.works')}<a href={ghActionsPath} class="text-primary-600 underline hover:text-primary-800">{t(lang, 'cliPage.install.ghAction')}</a>{t(lang, 'cliPage.install.and')}<a href={glCiPath} class="text-primary-600 underline hover:text-primary-800">{t(lang, 'cliPage.install.glCi')}</a>{t(lang, 'cliPage.install.dot')}</p>
  </div>
</section>

<!-- CTA -->
<section class="bg-primary-950 relative overflow-hidden">
  <div
    class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[500px] rounded-full opacity-20"
    style="background: radial-gradient(ellipse, #e8733a 0%, #b35a2b 40%, transparent 70%);"
  ></div>
  <div class="relative max-w-4xl mx-auto px-6 py-28 text-center">
    <h2 class="font-black tracking-tight leading-[0.95] text-primary-50">
      <span class="block text-4xl sm:text-5xl md:text-6xl">{t(lang, 'cta.title1')}</span>
      <span class="block text-4xl sm:text-5xl md:text-6xl italic text-primary-400">{t(lang, 'cta.title2')}</span>
    </h2>
    <p class="mt-6 text-lg text-primary-300 max-w-2xl mx-auto leading-relaxed">{t(lang, 'cta.subtitle')}</p>
    <div class="mt-10 flex gap-3 justify-center flex-wrap">
      <a
        href="https://github.com/FerrLabs/FerrFlow"
        class="px-8 py-4 rounded-full bg-primary-600 text-white font-medium text-lg hover:bg-primary-500 transition-colors shadow-lg shadow-primary-900/50"
      >
        {t(lang, 'cta.button')}
      </a>
      <a
        href={docsPath}
        class="px-8 py-4 rounded-full border border-primary-700 text-primary-100 font-medium text-lg hover:bg-primary-900 transition-colors"
      >
        {t(lang, 'cliPage.hero.docs')}
      </a>
    </div>
  </div>
</section>

<footer class="bg-primary-50 border-t border-primary-100">
  <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-primary-500">
    <span class="font-bold text-primary-800 tracking-tight">Ferr<span class="text-primary-600">Flow</span></span>
    <span>&copy; 2026 FerrFlow. All rights reserved.</span>
    <nav class="flex gap-6">
      <a href={docsPath} class="hover:text-primary-800 transition-colors">{t(lang, 'footer.documentation')}</a>
      <a href="https://github.com/FerrLabs/FerrFlow" class="hover:text-primary-800 transition-colors">GitHub</a>
      <a href="https://github.com/FerrLabs/FerrFlow/releases" class="hover:text-primary-800 transition-colors">{t(lang, 'footer.releases')}</a>
    </nav>
  </div>
</footer>

<style>
  .landing-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg, rgba(255, 248, 242, 0.9));
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-bottom: 1px solid var(--border, #ffe8d2);
  }

  .landing-header:not(.no-transition) {
    animation: header-fill 0.9s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .landing-header-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 4rem;
    display: flex;
    align-items: center;
  }
</style>
