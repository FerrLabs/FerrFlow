---
import Layout from '../layouts/Layout.astro';
---

<Layout title="FerrFlow - Universal Semantic Versioning">
  <div class="min-h-screen">
    <!-- Hero Section -->
    <div class="relative overflow-hidden bg-gradient-to-b from-primary-50 to-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
        <div class="text-center">
          <h1 class="text-5xl font-bold text-gray-900 sm:text-6xl md:text-7xl">
            Universal <span class="text-primary-600">Semantic Versioning</span>
          </h1>
          <p class="mt-6 text-xl text-gray-600 max-w-3xl mx-auto">
            FerrFlow reads your commit history, determines the right version bump, updates your version files, generates a changelog, and creates a tagged release — for any language, any repo layout.
          </p>
          <div class="mt-10 flex gap-4 justify-center">
            <a
              href="https://app.ferrflow.com"
              class="px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 md:text-lg"
            >
              Get Started
            </a>
            <a
              href="/docs"
              class="px-8 py-3 border border-gray-300 text-base font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 md:text-lg"
            >
              Documentation
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Features Section -->
    <div class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl">
            Why FerrFlow?
          </h2>
          <p class="mt-4 text-xl text-gray-600">
            Automate your release workflow with confidence
          </p>
        </div>

        <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-3">
          <div class="text-center">
            <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary-500 text-white mx-auto">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="mt-6 text-lg font-medium text-gray-900">Monorepo Support</h3>
            <p class="mt-2 text-base text-gray-500">
              First-class support for monorepos. Version multiple packages independently or together.
            </p>
          </div>

          <div class="text-center">
            <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary-500 text-white mx-auto">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="mt-6 text-lg font-medium text-gray-900">Language Agnostic</h3>
            <p class="mt-2 text-base text-gray-500">
              Works with any language: JavaScript, Rust, Python, Go, and more. Just configure your version files.
            </p>
          </div>

          <div class="text-center">
            <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary-500 text-white mx-auto">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
            </div>
            <h3 class="mt-6 text-lg font-medium text-gray-900">Conventional Commits</h3>
            <p class="mt-2 text-base text-gray-500">
              Automatically determines version bumps based on conventional commit messages.
            </p>
          </div>

          <div class="text-center">
            <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary-500 text-white mx-auto">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="mt-6 text-lg font-medium text-gray-900">Changelog Generation</h3>
            <p class="mt-2 text-base text-gray-500">
              Automatically generates beautiful changelogs from your commits.
            </p>
          </div>

          <div class="text-center">
            <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary-500 text-white mx-auto">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <h3 class="mt-6 text-lg font-medium text-gray-900">CI/CD Integration</h3>
            <p class="mt-2 text-base text-gray-500">
              Seamlessly integrates with GitHub Actions, GitLab CI, and other CI/CD platforms.
            </p>
          </div>

          <div class="text-center">
            <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary-500 text-white mx-auto">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h3 class="mt-6 text-lg font-medium text-gray-900">Secure & Private</h3>
            <p class="mt-2 text-base text-gray-500">
              Your code never leaves your infrastructure. FerrFlow runs entirely in your CI/CD pipeline.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="bg-primary-600">
      <div class="max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h2 class="text-3xl font-bold text-white sm:text-4xl">
            Ready to automate your releases?
          </h2>
          <p class="mt-4 text-xl text-primary-100">
            Start using FerrFlow today. No credit card required.
          </p>
          <div class="mt-8">
            <a
              href="https://app.ferrflow.com/register"
              class="inline-block px-8 py-3 border border-transparent text-base font-medium rounded-md text-primary-600 bg-white hover:bg-gray-50 md:text-lg"
            >
              Sign up for free
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="bg-gray-50 border-t border-gray-200">
      <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
        <div class="text-center text-gray-500 text-sm">
          <p>&copy; 2024 FerrFlow. All rights reserved.</p>
          <div class="mt-4 space-x-6">
            <a href="/docs" class="hover:text-gray-700">Documentation</a>
            <a href="https://github.com/FerrFlow-Org" class="hover:text-gray-700">GitHub</a>
            <a href="https://app.ferrflow.com" class="hover:text-gray-700">App</a>
          </div>
        </div>
      </div>
    </footer>
  </div>
</Layout>
