---
const accent = '#e8733a';
---

<header id="site-navbar">
  <div class="nav-container">
    <a href="/" class="nav-brand">
      <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" style={`color:${accent};`}>
        <line x1="6" y1="16" x2="14" y2="16" stroke="currentColor" stroke-width="1.5" />
        <line x1="18" y1="16" x2="24" y2="10" stroke="currentColor" stroke-width="1.5" />
        <line x1="18" y1="16" x2="24" y2="22" stroke="currentColor" stroke-width="1.5" />
        <circle cx="4" cy="16" r="3" fill="currentColor" />
        <circle cx="16" cy="16" r="3" fill="currentColor" />
        <circle cx="26" cy="10" r="3" fill="currentColor" opacity="0.6" />
        <circle cx="26" cy="22" r="3" fill="currentColor" opacity="0.6" />
      </svg>
      <span class="brand-name">ferrflow</span>
      <span class="mono brand-tag">by ferrlabs</span>
    </a>

    <nav class="desktop-nav">
      <a href="/docs/" class="nav-link mono">Docs</a>
      <a href="https://github.com/FerrLabs/FerrFlow" class="nav-link mono">GitHub ↗</a>
      <a href="https://ferrlabs.com" class="nav-link mono">FerrLabs ↗</a>

      <a href="https://github.com/FerrLabs/FerrFlow/releases" target="_blank" rel="noreferrer" class="cta-btn mono" style={`background:${accent}; border-color:${accent};`}>
        Get FerrFlow
        <span aria-hidden>↗</span>
      </a>
    </nav>

    <button class="mobile-toggle mono" id="nav-mobile-toggle" aria-label="Open menu">Menu</button>
  </div>
</header>

<script>
  const navbar = document.getElementById('site-navbar');
  const onScroll = () => {
    if (!navbar) return;
    if (window.scrollY > 8) navbar.classList.add('scrolled');
    else navbar.classList.remove('scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  #site-navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 248, 244, 0.65);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: background 200ms ease, border-color 200ms ease;
  }
  #site-navbar.scrolled {
    background: rgba(250, 248, 244, 0.85);
    border-bottom-color: rgba(30, 41, 59, 0.14);
  }
  .nav-container { max-width: 1440px; margin: 0 auto; padding: 0 40px; display: flex; align-items: center; height: 72px; gap: 24px; }
  @media (max-width: 768px) { .nav-container { padding: 0 20px; } }
  .nav-brand { display: flex; align-items: center; gap: 12px; letter-spacing: -0.01em; text-decoration: none; }
  .brand-name { font-family: "Fraunces", Georgia, ui-serif, serif; font-weight: 900; font-size: 22px; letter-spacing: -0.02em; color: #1e293b; }
  .brand-tag { font-size: 11px; color: #64748b; letter-spacing: 0.05em; margin-left: 4px; margin-top: 4px; }
  .mono { font-family: "DM Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .desktop-nav { display: flex; align-items: center; gap: 28px; margin-left: auto; }
  .nav-link { font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: #475569; position: relative; padding: 6px 0; text-decoration: none; }
  .nav-link::after { content: ""; position: absolute; left: 0; right: 0; bottom: -2px; height: 1px; background: #1e293b; transform: scaleX(0); transform-origin: left; transition: transform 220ms ease; }
  .nav-link:hover::after { transform: scaleX(1); }
  .cta-btn { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; padding: 10px 16px; border-radius: 999px; border: 1px solid; text-decoration: none; color: #fff; }
  .mobile-toggle { display: none; margin-left: auto; border: 1px solid rgba(30, 41, 59, 0.14); border-radius: 999px; background: transparent; color: #1e293b; padding: 8px 14px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; }
  @media (max-width: 880px) { .desktop-nav { display: none; } .mobile-toggle { display: inline-flex; } }
</style>
