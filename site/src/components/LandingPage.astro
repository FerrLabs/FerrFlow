        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-2xl font-black text-emerald-950 tracking-tight">{t(lang, 'products.secrets.name')}</h3>
          <span class="ml-auto text-xs font-medium text-emerald-600 bg-emerald-100 px-2.5 py-1 rounded-full">{t(lang, 'products.secrets.badge')}</span>
        </div>
        <p class="text-emerald-800 font-normal text-sm leading-relaxed mb-6">{t(lang, 'products.secrets.desc')}</p>

        <div class="mt-auto rounded-xl overflow-hidden border border-emerald-200 mb-6">
          <div class="bg-emerald-950 px-4 py-2.5 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-red-400/70"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-400/70"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-green-400/70"></span>
            <span class="ml-2 text-xs text-emerald-400 font-mono">ferrflow secrets</span>
          </div>
          <div class="bg-emerald-950 px-4 py-4 font-mono text-xs leading-6">
