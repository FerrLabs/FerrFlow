---
import Layout from '../../layouts/Layout.astro';
import LandingPage from '../../components/LandingPage.astro';
import { t } from '../../i18n/translations';

const siteUrl = 'https://ferrflow.com';
---

<Layout
  title={t('fr', 'meta.title')}
  description={t('fr', 'meta.description')}
  lang="fr"
  canonical={siteUrl + '/fr/'}
  alternates={[
    { lang: 'en', href: siteUrl + '/' },
    { lang: 'fr', href: siteUrl + '/fr/' },
  ]}
>
  <LandingPage lang="fr" />
</Layout>
