        <div class="text-center relative">
          <div class="text-7xl font-black text-primary-200 leading-none mb-4">{step.n}</div>
          <h3 class="text-xl font-bold text-primary-950 mb-2">{t(lang, step.titleKey)}</h3>
          <p class="text-primary-700 font-normal text-sm leading-relaxed max-w-xs mx-auto">{t(lang, step.descKey)}</p>
        </div>
      ))}
    </div>
