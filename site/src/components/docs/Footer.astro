---
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';

const route = Astro.locals.starlightRoute;
const filePath = route.entry.filePath;
const editHref = filePath
  ? `https://github.com/FerrLabs/FerrFlow-Cloud/edit/main/packages/site/${filePath}`
  : null;

const lang: 'fr' | 'en' = Astro.url.pathname.startsWith('/fr/') ? 'fr' : 'en';

const copy = {
  en: {
    helpful: 'Was this page helpful?',
    yes: 'Yes',
    no: 'No',
    edit: 'Edit on GitHub',
    thanks: 'Thanks for your feedback.',
  },
  fr: {
    helpful: 'Cette page vous a-t-elle été utile ?',
    yes: 'Oui',
    no: 'Non',
    edit: 'Modifier sur GitHub',
    thanks: 'Merci pour votre retour.',
  },
}[lang];
---

<footer class="sl-flex">
  <div class="ferr-feedback not-content">
    <p class="ferr-feedback__prompt" data-feedback-prompt>{copy.helpful}</p>
    <div class="ferr-feedback__actions">
      <button class="ferr-feedback__btn" data-feedback="yes" type="button">
        <span aria-hidden="true">↑</span>
        <span>{copy.yes}</span>
      </button>
      <button class="ferr-feedback__btn" data-feedback="no" type="button">
        <span aria-hidden="true">↓</span>
        <span>{copy.no}</span>
      </button>
      {
        editHref && (
          <a
            class="ferr-feedback__edit"
            href={editHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span aria-hidden="true">✎</span>
            <span>{copy.edit}</span>
          </a>
        )
      }
    </div>
  </div>

  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
</footer>

<script is:inline define:vars={{ thanks: copy.thanks }}>
  document.querySelectorAll('[data-feedback]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const wrap = btn.closest('.ferr-feedback');
      if (!wrap) return;
      wrap.querySelectorAll('[data-feedback]').forEach((b) => b.removeAttribute('data-active'));
      btn.setAttribute('data-active', 'true');
      const prompt = wrap.querySelector('[data-feedback-prompt]');
      if (prompt) prompt.textContent = thanks;
    });
  });
</script>

<style>
  @layer starlight.core {
    footer {
      flex-direction: column;
      gap: 1.5rem;
    }
    .meta {
      gap: 0.75rem 3rem;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: 1.5rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }
    .meta > :global(p:only-child) {
      margin-inline-start: auto;
    }
  }
</style>
