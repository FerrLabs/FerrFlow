          <p class="text-primary-700 font-normal text-sm leading-relaxed">{t(lang, `features.${f.key}.desc`)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ─── How it works ──────────────────────────────────────── -->
<section class="py-28 bg-primary-50 border-t border-primary-100">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl sm:text-5xl font-black text-primary-950 tracking-tight">{t(lang, 'how.title')}</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {[
        { n: '01', titleKey: 'how.step1.title' as const, descKey: 'how.step1.desc' as const },
        { n: '02', titleKey: 'how.step2.title' as const, descKey: 'how.step2.desc' as const },
        { n: '03', titleKey: 'how.step3.title' as const, descKey: 'how.step3.desc' as const },
