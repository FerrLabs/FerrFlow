{
  "meta": {
    "name": "no-versioned-files",
    "description": "Tag-only package (no versioned_files) gets released from git tags + conventional commits — see #531. Previously these packages were silently skipped."
  },
  "config": {
    "content": "{\n  \"package\": [\n    {\"name\": \"app\", \"path\": \".\", \"versioned_files\": []}\n  ]\n}\n"
  },
  "packages": [
    { "name": "app", "path": ".", "initial_version": "1.0.0", "tag": "v1.0.0" }
  ],
  "commits": [
    { "message": "feat: add feature", "files": ["src/main.rs"] }
  ],
  "expect": {
    "check_contains": ["app", "1.1.0"],
    "check_not_contains": [
      "Nothing to release",
      "no versioned files configured"
    ],
    "packages_released": 1
  }
}
