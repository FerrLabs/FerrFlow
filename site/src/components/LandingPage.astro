          </div>
          <div class="bg-indigo-950 px-4 py-4 font-mono text-xs leading-6">
            <p><span class="text-indigo-400">$ </span><span class="text-indigo-100">ferrflow issues list</span></p>
            <p><span class="text-indigo-500">#12 </span><span class="text-green-400">open  </span><span class="text-indigo-200">Add dark mode support</span></p>
            <p><span class="text-indigo-500">#11 </span><span class="text-red-400">closed</span><span class="text-indigo-300"> Fix login redirect loop</span></p>
            <p><span class="text-indigo-500">#10 </span><span class="text-green-400">open  </span><span class="text-indigo-200">API rate limiting</span></p>
          </div>
        </div>

        <span class="inline-flex items-center gap-1.5 text-sm font-medium text-indigo-400 cursor-default">
          {t(lang, 'products.issues.cta')}
