{
  "name": "FerrFlow Warm",
  "type": "dark",
  "colors": {
    "editor.background": "#2D1B0E",
    "editor.foreground": "#FFE8D2",
    "editor.selectionBackground": "#C85A2C44",
    "editor.lineHighlightBackground": "#6B270E33",
    "editorLineNumber.foreground": "#9E3F1A",
    "editorLineNumber.activeForeground": "#FF8F4F",
    "editorIndentGuide.background": "#6B270E55",
    "editorGroupHeader.tabsBackground": "#2D1B0E",
    "tab.activeBackground": "#2D1B0E",
    "tab.inactiveBackground": "#2D1B0E",
    "tab.activeForeground": "#FFE8D2",
    "tab.border": "#6B270E",
    "titleBar.activeBackground": "#2D1B0E",
    "panel.background": "#2D1B0E",
    "panel.border": "#6B270E",
    "focusBorder": "#E8733A"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#9E3F1A", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#E8733A" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": { "foreground": "#FFCBA4" }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": { "foreground": "#FF8F4F" }
    },
    {
      "name": "Variables and Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#FFB07A" }
    },
    {
      "name": "Numbers and Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": { "foreground": "#FFCBA4" }
    },
    {
      "name": "Operators and Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": { "foreground": "#C85A2C" }
    },
    {
      "name": "Types and Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": { "foreground": "#F07230" }
    },
    {
      "name": "Tags (HTML/JSX)",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": { "foreground": "#E8733A" }
    },
    {
      "name": "Attributes (HTML/JSX)",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#FF8F4F" }
    },
    {
      "name": "Regular Expressions",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#FFCBA4" }
    },
    {
      "name": "Escape Characters",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#FFCBA4" }
    },
    {
      "name": "Property Access",
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": { "foreground": "#FFB07A" }
    },
    {
      "name": "TOML/YAML/JSON Keys",
      "scope": [
        "keyword.key.toml",
        "entity.name.tag.yaml",
        "support.type.property-name.json"
      ],
      "settings": { "foreground": "#FF8F4F" }
    },
    {
      "name": "TOML/YAML/JSON Values (strings)",
      "scope": [
        "string.quoted.toml",
        "string.unquoted.yaml"
      ],
      "settings": { "foreground": "#FFCBA4" }
    },
    {
      "name": "Shell Commands",
      "scope": [
        "source.shell",
        "keyword.operator.redirect",
        "variable.other.special"
      ],
      "settings": { "foreground": "#FFE8D2" }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#E8733A", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown Links",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#FF8F4F" }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#FFCBA4" }
    },
    {
      "name": "Diff Added",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#22C55E" }
    },
    {
      "name": "Diff Removed",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#E8733A" }
    }
  ]
}
