---
import '../styles/global.css';
import type { Lang } from '../i18n/translations';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  lang?: Lang;
  alternates?: { lang: string; href: string }[];
}

const {
  title,
  description = 'Universal semantic versioning for monorepos and classic repos',
  canonical = Astro.url.href,
  lang = 'en',
  alternates = [],
} = Astro.props;

const ogImage = 'https://ferrflow.com/og.png';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#E8733A" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-dot-256.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="canonical" href={canonical} />
    {alternates.map(alt => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={alternates.find(a => a.lang === 'en')?.href ?? canonical} />
    )}

    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonical} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:site_name"   content="FerrFlow" />
    <meta property="og:locale"      content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    {alternates.filter(a => a.lang !== lang).map(alt => (
      <meta property="og:locale:alternate" content={alt.lang === 'fr' ? 'fr_FR' : 'en_US'} />
    ))}

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "FerrFlow",
      "url": "https://ferrflow.com",
      "description": description,
      "inLanguage": lang,
      "publisher": {
        "@type": "Organization",
        "name": "FerrFlow",
        "url": "https://ferrflow.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://ferrflow.com/icon-dot-256.svg"
        }
      }
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://github.com" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      html {
        scroll-behavior: smooth;
      }
      body {
        font-family: 'Fraunces', Georgia, serif;
        -webkit-font-smoothing: antialiased;
      }
    </style>
  </head>
  <body class="bg-primary-50 text-primary-950">
    <slot />
  </body>
</html>
