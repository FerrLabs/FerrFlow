{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "releaseCommitBody": "full",
    "updateLockfiles": true,
    "skipCi": false,
    "nestedPackages": "exclusive"
  },
  "package": [
    {
      "name": "ferrflow",
      "path": ".",
      "changelog": "CHANGELOG.md",
      "sharedPaths": [
        "src/"
      ],
      "tagTemplate": "v{version}",
      "latestTag": "latest",
      "floatingTags": [
        "major"
      ],
      "hooks": {
        "postBump": "node scripts/sync-optional-deps.js && node scripts/embed-release-data.js"
      },
      "versionedFiles": [
        {
          "path": "Cargo.toml",
          "format": "toml"
        },
        {
          "path": "npm/package.json",
          "format": "json"
        },
        {
          "path": "npm/platforms/linux-x64/package.json",
          "format": "json"
        },
        {
          "path": "npm/platforms/linux-arm64/package.json",
          "format": "json"
        },
        {
          "path": "npm/platforms/darwin-x64/package.json",
          "format": "json"
        },
        {
          "path": "npm/platforms/darwin-arm64/package.json",
          "format": "json"
        },
        {
          "path": "npm/platforms/win32-x64/package.json",
          "format": "json"
        },
        {
          "path": "npm/platforms/win32-arm64/package.json",
          "format": "json"
        },
        {
          "path": "npm/platforms/linux-arm/package.json",
          "format": "json"
        },
        {
          "path": "ferrflow-wasm/Cargo.toml",
          "format": "toml"
        },
        {
          "path": "docs/site/package.json",
          "format": "json"
        }
      ]
    },
    {
      "name": "site",
      "path": "site",
      "dependsOn": [
        {
          "name": "ferrflow",
          "propagate": "patch"
        }
      ],
      "changelog": "site/CHANGELOG.md",
      "versioning": "calver-seq",
      "tagTemplate": "{name}@v{version}",
      "latestTag": "{name}@latest",
      "versionedFiles": [
        {
          "path": "site/package.json",
          "format": "json"
        }
      ]
    },
    {
      "name": "api",
      "path": "api",
      "changelog": "api/CHANGELOG.md",
      "versioning": "calver-seq",
      "tagTemplate": "{name}@v{version}",
      "latestTag": "{name}@latest",
      "versionedFiles": [
        {
          "path": "api/Cargo.toml",
          "format": "toml"
        }
      ]
    }
  ]
}
