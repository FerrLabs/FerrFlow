---
import { t, getLocalizedPath } from '../i18n/translations';

interface Props {
  lang?: 'en' | 'fr';
  enEquiv?: string;
  frEquiv?: string;
  enAvailable?: boolean;
  frAvailable?: boolean;
}
const { lang = 'en', enEquiv = '/', frEquiv = '/fr/', enAvailable = true, frAvailable = true } = Astro.props;
const accent = '#e8733a';
const unavailableTitle = t(lang, 'lang.unavailable');
const docsHref = getLocalizedPath('/docs/introduction', lang);
const homeHref = lang === 'fr' ? '/fr/' : '/';
---

<header id="site-navbar">
  <div class="nav-container">
    <a href={homeHref} class="nav-brand" aria-label="FerrFlow">
      <svg width="20" height="20" viewBox="0 0 32 32" aria-hidden="true" style={`color:${accent};`}>
        <line x1="6" y1="16" x2="14" y2="16" stroke="currentColor" stroke-width="1.5" />
        <line x1="18" y1="16" x2="24" y2="10" stroke="currentColor" stroke-width="1.5" />
        <line x1="18" y1="16" x2="24" y2="22" stroke="currentColor" stroke-width="1.5" />
        <circle cx="4" cy="16" r="3" fill="currentColor" />
        <circle cx="16" cy="16" r="3" fill="currentColor" />
        <circle cx="26" cy="10" r="3" fill="currentColor" opacity="0.6" />
        <circle cx="26" cy="22" r="3" fill="currentColor" opacity="0.6" />
      </svg>
      <span class="brand-name">FerrFlow</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <a href={docsHref} class="nav-link">{t(lang, 'nav.docs')}</a>

      <div class="lang-pill">
        {enAvailable
          ? <a href={enEquiv} class:list={['lang-opt', lang === 'en' && 'active']}>EN</a>
          : <span class="lang-opt is-disabled" aria-disabled="true" title={unavailableTitle}>EN</span>}
        {frAvailable
          ? <a href={frEquiv} class:list={['lang-opt', lang === 'fr' && 'active']}>FR</a>
          : <span class="lang-opt is-disabled" aria-disabled="true" title={unavailableTitle}>FR</span>}
      </div>

      <a href="https://github.com/FerrLabs/FerrFlow" target="_blank" rel="noreferrer" class="nav-icon" aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.74.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.45.11-3.02 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.57.23 2.73.11 3.02.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" />
        </svg>
      </a>
    </nav>

    <button class="mobile-toggle" id="nav-mobile-toggle" aria-label="Open menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var navbar = document.getElementById('site-navbar');
    function onScroll() {
      if (!navbar) return;
      if (window.scrollY > 8) navbar.classList.add('scrolled');
      else navbar.classList.remove('scrolled');
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    document.querySelectorAll('a.lang-opt').forEach(function (a) {
      a.addEventListener('click', function () {
        try { localStorage.setItem('lang-pref', (a.textContent || '').trim().toLowerCase()); } catch (e) {}
      });
    });
    document.querySelectorAll('code, pre, kbd, samp').forEach(function (el) {
      el.setAttribute('translate', 'no');
      el.classList.add('notranslate');
    });
  })();
</script>

<style>
  #site-navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg, #fafafa) 88%, transparent);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease;
  }
  #site-navbar.scrolled {
    border-bottom-color: var(--hairline, #e4e4e7);
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    height: 56px;
    gap: 24px;
  }
  @media (max-width: 720px) { .nav-container { padding: 0 20px; } }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text, #18181b);
  }
  .brand-name {
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--text, #18181b);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-left: auto;
  }
  .nav-link {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted, #52525b);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .nav-link:hover { color: var(--text, #18181b); }

  .lang-pill {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--hairline, #e4e4e7);
    border-radius: 8px;
    overflow: hidden;
  }
  .lang-opt {
    font-size: 12px;
    font-weight: 500;
    padding: 5px 10px;
    color: var(--text-muted, #52525b);
    text-decoration: none;
    transition: background 150ms, color 150ms;
  }
  .lang-opt.active {
    background: var(--text, #18181b);
    color: var(--bg, #fafafa);
  }
  .lang-opt.is-disabled { opacity: 0.4; text-decoration: line-through; cursor: not-allowed; }

  .nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: var(--text-muted, #52525b);
    text-decoration: none;
    transition: color 150ms ease, background 150ms ease;
  }
  .nav-icon:hover { color: var(--text, #18181b); background: color-mix(in oklab, var(--text, #18181b) 6%, transparent); }

  .mobile-toggle {
    display: none;
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--hairline, #e4e4e7);
    color: var(--text, #18181b);
    border-radius: 8px;
    padding: 6px 8px;
    cursor: pointer;
  }
  @media (max-width: 720px) {
    .desktop-nav { display: none; }
    .mobile-toggle { display: inline-flex; }
  }
</style>
