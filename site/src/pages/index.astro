---
import Layout from '../layouts/Layout.astro';
import LandingPage from '../components/LandingPage.astro';
import { t } from '../i18n/translations';

const siteUrl = 'https://ferrflow.com';
---

<Layout
  title={t('en', 'meta.title')}
  description={t('en', 'meta.description')}
  lang="en"
  canonical={siteUrl + '/'}
  alternates={[
    { lang: 'en', href: siteUrl + '/' },
    { lang: 'fr', href: siteUrl + '/fr/' },
  ]}
>
  <LandingPage lang="en" />
</Layout>
