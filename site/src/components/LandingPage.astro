            <p><span class="text-emerald-400">&check; </span><span class="text-emerald-200">Secret DB_URL stored (encrypted)</span></p>
            <p class="mt-1"><span class="text-emerald-400">$ </span><span class="text-emerald-100">ferrflow secrets inject -- npm test</span></p>
            <p><span class="text-emerald-500">  Injecting 3 secrets into environment...</span></p>
          </div>
        </div>

        <span class="inline-flex items-center gap-1.5 text-sm font-medium text-emerald-400 cursor-default">
          {t(lang, 'products.secrets.cta')}
        </span>
