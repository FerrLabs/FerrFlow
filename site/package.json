{
  "name": "@ferrflow/site",
  "private": true,
  "license": "MPL-2.0",
  "version": "2026.11.22",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.8.0"
  },
  "scripts": {
    "dev": "node scripts/sync-docs.mjs && vite",
    "build": "node scripts/sync-docs.mjs && vite build && node scripts/gen-rss.mjs && node scripts/gen-sitemap.mjs",
    "test": "node --experimental-strip-types --test 'src/**/*.spec.ts'",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "check:i18n": "node ./scripts/check-i18n.mjs",
    "preview": "vite preview",
    "docs:sync": "node scripts/sync-docs.mjs",
    "ci:local": "pnpm typecheck && pnpm test && pnpm build && pnpm check:i18n",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@analogjs/content": "^2.6.1",
    "@analogjs/router": "^2.6.1",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/localize": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@ferrlabs/telemetry": "^0.6.1",
    "@ferrlabs/ui-foundation": "^5.12.0",
    "@ferrlabs/ui-ng": "^1.61.1",
    "chart.js": "^4.5.1",
    "front-matter": "^4.0.2",
    "marked": "^18.0.0",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "prismjs": "^1.29.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.6.1",
    "@angular/build": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}
