---
import '../styles/global.css';
import Navbar from '@ferrlabs/ui-astro/Navbar.astro';
import Footer from '@ferrlabs/ui-astro/Footer.astro';
import { t, type Lang } from '../i18n/translations';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  lang?: Lang;
  alternates?: { lang: string; href: string }[];
  pathname?: string;
}

const {
  title,
  description = 'Universal semantic versioning for monorepos and classic repos',
  canonical = Astro.url.href,
  lang = 'en',
  alternates = [],
  pathname = Astro.url.pathname,
} = Astro.props;

const ogImage = 'https://ferrflow.com/og.png';

const enEquiv =
  pathname.startsWith('/fr/') ? pathname.slice(3) || '/'
  : pathname === '/fr' ? '/'
  : pathname;
const frEquiv = enEquiv === '/' ? '/fr/' : `/fr${enEquiv.startsWith('/') ? '' : '/'}${enEquiv}`;

const homeHref = lang === 'fr' ? '/fr/' : '/';
const docsHref = lang === 'fr' ? '/fr/docs/introduction/' : '/docs/introduction/';

const navLinks = [
  { label: t(lang, 'nav.docs'), href: docsHref },
  { label: 'GitHub', href: 'https://github.com/FerrLabs/FerrFlow', external: true },
];

const products = [
  { name: 'FerrFlow', href: 'https://ferrflow.com', accent: '#e8733a', current: true },
  { name: 'FerrVault', href: 'https://vault.ferrlabs.com', accent: '#10b981' },
  { name: 'FerrTrack', href: 'https://track.ferrlabs.com', accent: '#6366f1' },
  { name: 'FerrGrowth', href: 'https://ferrgrowth.com', accent: '#7c3aed' },
  { name: 'FerrFleet', href: 'https://fleet.ferrlabs.com', accent: '#f59e0b' },
];

const legalBase = lang === 'fr' ? '/fr' : '';
const legalLinks = [
  { label: t(lang, 'footer.mentions'), href: `${legalBase}/legal` },
  { label: t(lang, 'footer.privacy'),  href: `${legalBase}/privacy` },
  { label: t(lang, 'footer.terms'),    href: `${legalBase}/terms` },
  { label: t(lang, 'footer.cookies'),  href: `${legalBase}/cookies` },
];
const resourceLinks = [
  { label: t(lang, 'footer.documentation'), href: docsHref },
  { label: t(lang, 'footer.releases'), href: 'https://github.com/FerrLabs/FerrFlow/releases' },
  { label: t(lang, 'footer.discussions'), href: 'https://github.com/FerrLabs/FerrFlow/discussions' },
];
---

<!doctype html>
<html lang={lang} translate="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="google" content="notranslate" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#E8733A" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="canonical" href={canonical} />
    {alternates.map(alt => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={alternates.find(a => a.lang === 'en')?.href ?? canonical} />
    )}

    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonical} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:site_name"   content="FerrFlow" />
    <meta property="og:locale"      content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    {alternates.filter(a => a.lang !== lang).map(alt => (
      <meta property="og:locale:alternate" content={alt.lang === 'fr' ? 'fr_FR' : 'en_US'} />
    ))}

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "FerrFlow",
      "url": "https://ferrflow.com",
      "description": description,
      "inLanguage": lang,
      "publisher": {
        "@type": "Organization",
        "name": "FerrFlow",
        "url": "https://ferrflow.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://ferrflow.com/icon-dot-256.svg"
        }
      }
    })} />

    <link rel="dns-prefetch" href="https://github.com" />
  </head>
  <body>
    <Navbar
      lang={lang}
      accent="#e8733a"
      brandName="ferrflow"
      brandTag="by ferrlabs"
      brandHref={homeHref}
      enEquiv={enEquiv}
      frEquiv={frEquiv}
      navLinks={navLinks}
      gitHubUrl="https://github.com/FerrLabs/FerrFlow"
      cta={{ label: t(lang, 'nav.cta'), href: 'https://github.com/FerrLabs/FerrFlow/releases/latest', external: true }}
    >
      <svg slot="logo" width="26" height="26" viewBox="0 0 32 32" aria-hidden="true" style="color:#e8733a;">
        <line x1="6" y1="16" x2="14" y2="16" stroke="currentColor" stroke-width="1.5" />
        <line x1="18" y1="16" x2="24" y2="10" stroke="currentColor" stroke-width="1.5" />
        <line x1="18" y1="16" x2="24" y2="22" stroke="currentColor" stroke-width="1.5" />
        <circle cx="4" cy="16" r="3" fill="currentColor" />
        <circle cx="16" cy="16" r="3" fill="currentColor" />
        <circle cx="26" cy="10" r="3" fill="currentColor" opacity="0.6" />
        <circle cx="26" cy="22" r="3" fill="currentColor" opacity="0.6" />
      </svg>
    </Navbar>
    <main>
      <slot />
    </main>
    <Footer
      lang={lang}
      accent="#e8733a"
      brandName="ferrflow"
      tagline={t(lang, 'footer.tagline')}
      products={products}
      links={{ resources: resourceLinks, legal: legalLinks }}
      rights={t(lang, 'footer.rights')}
      backToHolding={{ label: t(lang, 'footer.back'), href: 'https://ferrlabs.com' }}
    >
      <svg slot="logo" width="36" height="36" viewBox="0 0 32 32" aria-hidden="true" style="color:#e8733a;">
        <line x1="6" y1="16" x2="14" y2="16" stroke="currentColor" stroke-width="1.5" />
        <line x1="18" y1="16" x2="24" y2="10" stroke="currentColor" stroke-width="1.5" />
        <line x1="18" y1="16" x2="24" y2="22" stroke="currentColor" stroke-width="1.5" />
        <circle cx="4" cy="16" r="3" fill="currentColor" />
        <circle cx="16" cy="16" r="3" fill="currentColor" />
        <circle cx="26" cy="10" r="3" fill="currentColor" opacity="0.6" />
        <circle cx="26" cy="22" r="3" fill="currentColor" opacity="0.6" />
      </svg>
    </Footer>
    <script>
      import '../scripts/i18n';
    </script>
    <style is:global>
      body { min-height: 100dvh; display: flex; flex-direction: column; }
      main { flex: 1 0 auto; }
      footer { flex-shrink: 0; }
    </style>
  </body>
</html>
