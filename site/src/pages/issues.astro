---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="FerrFlow Issues" description="CLI-native issue tracking with a clean web dashboard. Coming soon." lang="en">
  <header class="landing-header"><div class="landing-header-inner"><Navbar lang="en" activePage="home" accent="#6366F1" /></div></header>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-indigo-50">
    <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[600px] rounded-full opacity-40" style="background: radial-gradient(ellipse, #A5B4FC 0%, #E0E7FF 40%, transparent 70%);"></div>
    <div class="relative max-w-5xl mx-auto px-6 pt-24 pb-16">
      <div class="flex items-center justify-center gap-2 mb-6">
        <span class="px-3 py-1 rounded-full bg-indigo-100 text-indigo-700 text-xs font-medium">Coming soon</span>
      </div>
      <h1 class="text-center font-black text-indigo-950 tracking-tight leading-[0.95]">
        <span class="block text-7xl sm:text-8xl md:text-[7rem] lg:text-[8.5rem]">Issues that live</span>
        <span class="block text-7xl sm:text-8xl md:text-[7rem] lg:text-[8.5rem] italic text-indigo-500">where you work.</span>
      </h1>
      <p class="mt-8 text-center text-lg sm:text-xl text-indigo-800 max-w-2xl mx-auto leading-relaxed">
        Create tickets from your terminal, triage from a clean web dashboard, automate with AI. No more context switching between your editor and a browser tab.
      </p>
    </div>
  </section>

  <!-- Blurred preview -->
  <section class="py-16 bg-white border-t border-indigo-100">
    <div class="max-w-3xl mx-auto px-6">
      <div class="relative rounded-2xl overflow-hidden border border-indigo-200 shadow-lg shadow-indigo-100/50" style="min-height: 300px;">
        <div class="bg-indigo-50 p-6" style="filter: blur(3px);">
          <div class="flex gap-2 mb-4">
            <div class="h-8 bg-white rounded-lg border border-indigo-100 w-16"></div>
            <div class="h-8 bg-indigo-100 rounded-lg w-20"></div>
            <div class="h-8 bg-white rounded-lg border border-indigo-100 w-24"></div>
          </div>
          <div class="space-y-3">
            <div class="flex items-center gap-3 p-4 bg-white rounded-lg border border-indigo-100">
              <div class="w-3 h-3 rounded-full bg-green-400"></div>
              <div class="h-4 bg-indigo-200 rounded w-1/3"></div>
              <div class="h-3 bg-indigo-100 rounded w-12 ml-2"></div>
              <div class="ml-auto h-3 bg-indigo-100 rounded w-16"></div>
            </div>
            <div class="flex items-center gap-3 p-4 bg-white rounded-lg border border-indigo-100">
              <div class="w-3 h-3 rounded-full bg-amber-400"></div>
              <div class="h-4 bg-indigo-200 rounded w-1/2"></div>
              <div class="h-3 bg-red-100 rounded w-8 ml-2"></div>
              <div class="ml-auto h-3 bg-indigo-100 rounded w-16"></div>
            </div>
            <div class="flex items-center gap-3 p-4 bg-white rounded-lg border border-indigo-100">
              <div class="w-3 h-3 rounded-full bg-indigo-300"></div>
              <div class="h-4 bg-indigo-200 rounded w-2/5"></div>
              <div class="ml-auto h-3 bg-indigo-100 rounded w-16"></div>
            </div>
            <div class="flex items-center gap-3 p-4 bg-white rounded-lg border border-indigo-100">
              <div class="w-3 h-3 rounded-full bg-green-400"></div>
              <div class="h-4 bg-indigo-200 rounded w-1/4"></div>
              <div class="h-3 bg-indigo-100 rounded w-16 ml-2"></div>
              <div class="ml-auto h-3 bg-indigo-100 rounded w-16"></div>
            </div>
          </div>
        </div>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="text-center bg-white/80 backdrop-blur-sm rounded-xl px-8 py-5 shadow-sm border border-indigo-200">
            <p class="text-xl font-black text-indigo-900">Coming soon</p>
            <p class="mt-1 text-sm text-indigo-600">Under active development</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 bg-indigo-50 border-t border-indigo-100">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-black text-indigo-950 text-center tracking-tight mb-14">What to expect</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-indigo-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6z" /></svg>
          </div>
          <div>
            <h3 class="font-bold text-indigo-950 text-lg">Web dashboard</h3>
            <p class="mt-1 text-sm text-indigo-700 leading-relaxed">A fast, clean dashboard at app.ferrflow.com to view, filter, and manage issues across all your projects.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-indigo-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z" /></svg>
          </div>
          <div>
            <h3 class="font-bold text-indigo-950 text-lg">CLI integration</h3>
            <p class="mt-1 text-sm text-indigo-700 leading-relaxed">ferrflow issues create, list, update, comment. Manage tickets without leaving your terminal.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-indigo-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>
          </div>
          <div>
            <h3 class="font-bold text-indigo-950 text-lg">AI-powered triage</h3>
            <p class="mt-1 text-sm text-indigo-700 leading-relaxed">Automatic label classification, priority suggestions, and sprint summaries built into the workflow.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-indigo-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
          </div>
          <div>
            <h3 class="font-bold text-indigo-950 text-lg">Project-scoped</h3>
            <p class="mt-1 text-sm text-indigo-700 leading-relaxed">Issues tied to projects with role-based access. FerrFlow is the source of truth for your team.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-indigo-950">
    <div class="max-w-4xl mx-auto px-6 py-24 text-center">
      <h2 class="text-4xl sm:text-5xl font-black text-indigo-50 tracking-tight">Tired of switching tabs<br /><span class="italic text-indigo-300">to manage tickets?</span></h2>
      <p class="mt-4 text-lg text-indigo-400">FerrFlow Issues brings tracking to your terminal and your browser. One source of truth.</p>
      <a href="https://github.com/FerrFlow-Org/FerrFlow" class="mt-10 inline-block px-8 py-4 rounded-full bg-indigo-500 text-white font-medium text-lg hover:bg-indigo-400 transition-colors shadow-lg shadow-indigo-900/50">View on GitHub</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-indigo-50 border-t border-indigo-100">
    <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-indigo-500">
      <span class="font-bold text-indigo-800 tracking-tight">Ferr<span class="text-indigo-500">Flow</span></span>
      <span>&copy; 2026 FerrFlow. All rights reserved.</span>
      <nav class="flex gap-6">
        <a href="/docs/introduction" class="hover:text-indigo-800 transition-colors">Documentation</a>
        <a href="https://github.com/FerrFlow-Org/FerrFlow" class="hover:text-indigo-800 transition-colors">GitHub</a>
      </nav>
    </div>
  </footer>
</Layout>

<style>
  .landing-header { position: sticky; top: 0; z-index: 50; background: rgba(238, 242, 255, 0.9); backdrop-filter: blur(4px); border-bottom: 1px solid #E0E7FF; }
  .landing-header-inner { max-width: 72rem; margin: 0 auto; padding: 0 1.5rem; height: 4rem; display: flex; align-items: center; }
</style>
