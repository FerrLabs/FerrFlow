---
import { t, type Lang } from '../i18n/translations';
import benchmarks from '../data/benchmarks.json';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const ferrflowSemver = benchmarks.ferrflow_version.replace(/^ferrflow\s+/, '');
const ferrflowVersion = `v${ferrflowSemver}`;
const ferrflowMajor = `v${ferrflowSemver.split('.')[0]}`;

const releaseSizeMb = (benchmarks as unknown as { ferrflow_release_size_mb?: string })
  .ferrflow_release_size_mb;
const ferrflowBinarySize = releaseSizeMb
  ? `~${Math.round(parseFloat(releaseSizeMb))} MB`
  : `~${Math.round(parseFloat(benchmarks.ferrflow_binary_size_mb))} MB`;

const features = ['01', '02', '03', '04', '05', '06'] as const;

const installCells = [
  { k: 'Cargo', cmd: 'cargo install ferrflow' },
  { k: 'npm', cmd: 'npm install -D ferrflow' },
  { k: 'Docker', cmd: 'docker run ghcr.io/ferrlabs/ferrflow' },
  { k: 'GitHub', cmd: `uses: FerrLabs/FerrFlow@${ferrflowMajor}` },
];

const formats = [
  'Cargo.toml',
  'package.json',
  'pyproject.toml',
  'pom.xml',
  '*.csproj',
  'build.gradle',
  'Chart.yaml',
  'pubspec.yaml',
  'mix.exs',
  '*.gemspec',
  'Package.swift',
  'go.mod',
  'composer.json',
];

const heroStats = [
  { k: t(lang, 'hero.stat.latest'), v: ferrflowVersion },
  { k: t(lang, 'hero.stat.license'), v: 'MPL-2.0' },
  { k: t(lang, 'hero.stat.lang'), v: 'Rust' },
  { k: t(lang, 'hero.stat.size'), v: ferrflowBinarySize },
];

const docsHref = lang === 'fr' ? '/fr/docs/introduction/' : '/docs/introduction/';
---

<section class="hero-section">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-left">
        <h1 class="hero-title">
          {t(lang, 'hero.h1')}
          <br />
          <span class="hero-italic">{t(lang, 'hero.h2')}</span>
        </h1>
        <p class="hero-sub">{t(lang, 'hero.sub')}</p>

        <div class="hero-actions">
          <a href="https://github.com/FerrLabs/FerrFlow" class="btn-primary mono">
            <span class="hero-prompt">$</span>{t(lang, 'hero.cta1')}
          </a>
          <a href={docsHref} class="btn-ghost">{t(lang, 'hero.cta2')}</a>
        </div>

        <div class="hero-stats">
          {
            heroStats.map((s) => (
              <div>
                <div class="mono hero-stat-key">{s.k}</div>
                <div class="mono hero-stat-val">{s.v}</div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="terminal">
        <div class="terminal-chrome">
          <span class="terminal-dot terminal-dot-accent"></span>
          <span class="terminal-dot"></span>
          <span class="terminal-dot"></span>
          <span class="terminal-title">~/code/monorepo · ferrflow v4.2</span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-prompt">$</span><span>ferrflow release</span>
          </div>
          <div class="terminal-line is-dim">
            <span class="terminal-prompt">→</span><span>{t(lang, 'terminal.reading')}</span>
          </div>
          <div class="terminal-line is-dim">
            <span class="terminal-prompt">→</span><span>{t(lang, 'terminal.detected')}</span>
          </div>
          <div class="terminal-line is-dim">
            <span class="terminal-prompt">→</span><span>{t(lang, 'terminal.scanning')}</span>
          </div>
          <div class="terminal-line is-ok">
            <span class="terminal-prompt is-ok">✓</span><span
              >bump api v4.1.7 → v5.0.0 (breaking)</span
            >
          </div>
          <div class="terminal-line is-ok">
            <span class="terminal-prompt is-ok">✓</span><span>bump app v4.1.4 → v4.2.0 (minor)</span
            >
          </div>
          <div class="terminal-line is-ok">
            <span class="terminal-prompt is-ok">✓</span><span
              >bump site v1.3.9 → v1.4.0 (minor)</span
            >
          </div>
          <div class="terminal-line is-ok">
            <span class="terminal-prompt is-ok">✓</span><span
              >bump admin v0.8.2 → v0.8.3 (patch)</span
            >
          </div>
          <div class="terminal-line is-dim">
            <span class="terminal-prompt">→</span><span>{t(lang, 'terminal.generating')}</span>
          </div>
          <div class="terminal-line is-ok">
            <span class="terminal-prompt is-ok">✓</span><span>{t(lang, 'terminal.published')}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="formats-strip">
  <div class="container formats-row">
    <span class="mono formats-eyebrow">{t(lang, 'formats.label')}</span>
    <div class="formats-chips">
      {formats.map((f) => <span class="mono formats-chip">{f}</span>)}
    </div>
  </div>
</section>

<section id="features" class="features-section">
  <div class="container">
    <p class="mono section-eyebrow">{t(lang, 'features.eyebrow')}</p>
    <div class="features-header">
      <h2 class="section-title">{t(lang, 'features.title')}</h2>
      <p class="features-sub">{t(lang, 'features.sub')}</p>
    </div>

    <div class="features-grid">
      {
        features.map((k, i) => (
          <div class="feature-cell" data-i={i}>
            <span class="mono feature-key">— {k}</span>
            <h3 class="feature-title">{t(lang, `features.${k}.title` as any)}</h3>
            <p class="feature-body">{t(lang, `features.${k}.body` as any)}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section id="install" class="install-section">
  <div class="container">
    <p class="mono section-eyebrow">{t(lang, 'install.eyebrow')}</p>
    <h2 class="section-title">{t(lang, 'install.title')}</h2>
    <p class="install-sub">{t(lang, 'install.sub')}</p>

    <div class="install-grid">
      {
        installCells.map((i) => (
          <div class="install-cell">
            <div class="mono install-key">{i.k}</div>
            <code class="mono install-cmd">
              <span class="install-prompt">$</span>
              {i.cmd}
            </code>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container">
    <div class="cta-block">
      <div>
        <p class="mono cta-eyebrow">{t(lang, 'cta.eyebrow')}</p>
        <h2 class="cta-title">
          {t(lang, 'cta.title1')}
          <br />
          <span class="cta-italic">{t(lang, 'cta.title2')}</span>
        </h2>
        <p class="cta-sub">{t(lang, 'cta.subtitle')}</p>
      </div>
      <div class="cta-actions">
        <a href="https://github.com/FerrLabs/FerrFlow" class="cta-btn cta-btn-primary mono"
          >★ {t(lang, 'cta.button')} →</a
        >
        <a href="#install" class="cta-btn cta-btn-ghost mono">{t(lang, 'cta.installShort')} →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 80px 0 96px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }

  .hero-left {
    min-width: 0;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: clamp(48px, 6.5vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0;
    overflow-wrap: break-word;
    hyphens: none;
  }
  .hero-italic {
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }

  .hero-sub {
    font-size: 18px;
    line-height: 1.55;
    color: var(--fg-2);
    max-width: 540px;
    margin: 28px 0 0;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .hero-prompt {
    opacity: 0.65;
    margin-right: 6px;
  }

  .hero-stats {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    margin-top: 40px;
  }
  .hero-stat-key {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: 4px;
  }
  .hero-stat-val {
    font-size: 14px;
    color: var(--fg);
  }

  .terminal {
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 14px;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.7;
    box-shadow: 0 28px 56px -28px rgba(15, 23, 42, 0.22);
  }
  .terminal-chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--rule);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: var(--rule-strong);
  }
  .terminal-dot-accent {
    background: var(--accent);
  }
  .terminal-title {
    margin-left: 12px;
  }
  .terminal-body {
    padding: 20px 22px 26px;
    min-height: 320px;
  }
  .terminal-line {
    display: flex;
    gap: 12px;
    color: var(--fg);
  }
  .terminal-line.is-dim {
    color: var(--fg-3);
  }
  .terminal-line.is-ok {
    color: var(--fg);
  }
  .terminal-prompt {
    color: var(--fg-3);
    min-width: 14px;
  }
  .terminal-prompt.is-ok {
    color: var(--accent);
  }

  @media (max-width: 880px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  .formats-strip {
    padding: 32px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .formats-row {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .formats-eyebrow {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .formats-chips {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    flex: 1;
  }
  .formats-chip {
    font-size: 12px;
    color: var(--fg-2);
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--card);
  }

  .features-section {
    padding: 96px 0;
  }
  .section-eyebrow {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin: 0 0 28px;
  }
  .section-title {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: clamp(40px, 6vw, 88px);
    line-height: 0.94;
    letter-spacing: -0.04em;
    margin: 0;
  }
  .features-header {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 48px;
    margin-bottom: 64px;
    align-items: end;
  }
  .features-sub {
    font-size: 17px;
    line-height: 1.55;
    color: var(--fg-2);
    margin: 0;
    align-self: end;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--rule);
    border-radius: 18px;
    overflow: hidden;
    background: var(--card);
  }
  .feature-cell {
    padding: 32px;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .feature-cell[data-i='2'],
  .feature-cell[data-i='5'] {
    border-right: none;
  }
  .feature-cell[data-i='3'],
  .feature-cell[data-i='4'],
  .feature-cell[data-i='5'] {
    border-bottom: none;
  }
  .feature-key {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .feature-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .feature-body {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--fg-2);
    margin: 12px 0 0;
  }

  @media (max-width: 900px) {
    .features-header {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
    .feature-cell {
      border-right: 1px solid var(--rule);
      border-bottom: 1px solid var(--rule);
    }
    .feature-cell[data-i='1'],
    .feature-cell[data-i='3'],
    .feature-cell[data-i='5'] {
      border-right: none;
    }
    .feature-cell[data-i='2'] {
      border-right: 1px solid var(--rule);
    }
    .feature-cell[data-i='4'],
    .feature-cell[data-i='5'] {
      border-bottom: none;
    }
  }
  @media (max-width: 600px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
    .feature-cell {
      border-right: none !important;
      border-bottom: 1px solid var(--rule) !important;
    }
    .feature-cell:last-child {
      border-bottom: none !important;
    }
  }

  .install-section {
    padding: 64px 0 96px;
  }
  .install-sub {
    font-size: 17px;
    color: var(--fg-2);
    max-width: 640px;
    margin: 24px 0 48px;
  }
  .install-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .install-cell {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 20px;
  }
  .install-key {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: 12px;
  }
  .install-cmd {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg);
    display: block;
    word-break: break-all;
  }
  .install-prompt {
    color: var(--accent);
    margin-right: 6px;
  }
  @media (max-width: 900px) {
    .install-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 540px) {
    .install-grid {
      grid-template-columns: 1fr;
    }
  }

  .cta-section {
    padding: 32px 0 80px;
  }
  .cta-block {
    background: var(--fg);
    color: var(--bg);
    border-radius: 24px;
    padding: clamp(40px, 6vw, 80px);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }
  .cta-eyebrow {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
    margin: 0 0 24px;
  }
  .cta-title {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: clamp(36px, 5vw, 72px);
    line-height: 0.96;
    letter-spacing: -0.04em;
    margin: 0;
  }
  .cta-italic {
    font-style: italic;
    font-weight: 400;
  }
  .cta-sub {
    font-size: 17px;
    opacity: 0.7;
    margin: 20px 0 0;
    max-width: 480px;
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  .cta-btn {
    padding: 18px 28px;
    border-radius: 999px;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .cta-btn-primary {
    background: var(--accent);
    color: #fff;
  }
  .cta-btn-ghost {
    background: transparent;
    color: var(--bg);
    border: 1px solid color-mix(in oklab, var(--bg) 30%, transparent);
  }
  @media (max-width: 760px) {
    .cta-block {
      grid-template-columns: 1fr;
    }
  }
</style>
