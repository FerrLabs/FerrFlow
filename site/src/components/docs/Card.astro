---
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';

interface Props {
  title: string;
  href?: string;
  icon?: StarlightIcon;
}

const { title, href, icon } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="ferr-card" href={href}>
  <p class="ferr-card__title">
    {icon && <Icon name={icon} class="ferr-card__icon" />}
    <span>{title}</span>
  </p>
  <div class="ferr-card__body">
    <slot />
  </div>
</Tag>
