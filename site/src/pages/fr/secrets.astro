---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { t, type Lang } from '../../i18n/translations';

const lang: Lang = 'fr';
---

<Layout title={t(lang, 'secretsPage.meta.title')} description={t(lang, 'secretsPage.meta.description')} lang={lang} accent="#10B981">
  <header class="landing-header"><div class="landing-header-inner"><Navbar lang={lang} activePage="home" accent="#10B981" /></div></header>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-emerald-50">
    <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[600px] rounded-full opacity-40" style="background: radial-gradient(ellipse, #6EE7B7 0%, #D1FAE5 40%, transparent 70%);"></div>
    <div class="relative max-w-5xl mx-auto px-6 pt-24 pb-16">
      <div class="flex items-center justify-center gap-2 mb-6">
        <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-700 text-xs font-medium">{t(lang, 'secretsPage.hero.badge')}</span>
      </div>
      <h1 class="text-center font-black text-emerald-950 tracking-tight leading-[0.95]">
        <span class="block text-7xl sm:text-8xl md:text-[7rem] lg:text-[8.5rem]">{t(lang, 'secretsPage.hero.headline1')}</span>
        <span class="block text-7xl sm:text-8xl md:text-[7rem] lg:text-[8.5rem] italic text-emerald-500">{t(lang, 'secretsPage.hero.headline2')}</span>
      </h1>
      <p class="mt-8 text-center text-lg sm:text-xl text-emerald-800 max-w-2xl mx-auto leading-relaxed">
        {t(lang, 'secretsPage.hero.subheading')}
      </p>
    </div>
  </section>

  <!-- Blurred preview -->
  <section class="py-16 bg-white border-t border-emerald-100">
    <div class="max-w-3xl mx-auto px-6">
      <div class="relative rounded-2xl overflow-hidden border border-emerald-200 shadow-lg shadow-emerald-100/50" style="min-height: 260px;">
        <div class="bg-emerald-50 p-6" style="filter: blur(3px);">
          <div class="space-y-3">
            <div class="flex items-center gap-3 p-3 bg-white rounded-lg border border-emerald-100">
              <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
              <div class="h-3 bg-emerald-200 rounded w-24"></div>
              <div class="h-3 bg-emerald-100 rounded flex-1"></div>
              <div class="h-3 bg-emerald-200 rounded w-20"></div>
            </div>
            <div class="flex items-center gap-3 p-3 bg-white rounded-lg border border-emerald-100">
              <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
              <div class="h-3 bg-emerald-200 rounded w-32"></div>
              <div class="h-3 bg-emerald-100 rounded flex-1"></div>
              <div class="h-3 bg-emerald-200 rounded w-20"></div>
            </div>
            <div class="flex items-center gap-3 p-3 bg-white rounded-lg border border-emerald-100">
              <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
              <div class="h-3 bg-emerald-200 rounded w-20"></div>
              <div class="h-3 bg-emerald-100 rounded flex-1"></div>
              <div class="h-3 bg-emerald-200 rounded w-20"></div>
            </div>
          </div>
        </div>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="text-center bg-white/80 backdrop-blur-sm rounded-xl px-8 py-5 shadow-sm border border-emerald-200">
            <p class="text-xl font-black text-emerald-900">{t(lang, 'secretsPage.preview.title')}</p>
            <p class="mt-1 text-sm text-emerald-600">{t(lang, 'secretsPage.preview.subtitle')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 bg-emerald-50 border-t border-emerald-100">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-black text-emerald-950 text-center tracking-tight mb-14">{t(lang, 'secretsPage.features.title')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25H6.75A4.5 4.5 0 002.25 10.5v4.5z" /></svg>
          </div>
          <div>
            <h3 class="font-bold text-emerald-950 text-lg">{t(lang, 'secretsPage.features.infra.title')}</h3>
            <p class="mt-1 text-sm text-emerald-700 leading-relaxed">{t(lang, 'secretsPage.features.infra.desc')}</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>
          </div>
          <div>
            <h3 class="font-bold text-emerald-950 text-lg">{t(lang, 'secretsPage.features.ci.title')}</h3>
            <p class="mt-1 text-sm text-emerald-700 leading-relaxed">{t(lang, 'secretsPage.features.ci.desc')}</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" /></svg>
          </div>
          <div>
            <h3 class="font-bold text-emerald-950 text-lg">{t(lang, 'secretsPage.features.rotation.title')}</h3>
            <p class="mt-1 text-sm text-emerald-700 leading-relaxed">{t(lang, 'secretsPage.features.rotation.desc')}</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          </div>
          <div>
            <h3 class="font-bold text-emerald-950 text-lg">{t(lang, 'secretsPage.features.rbac.title')}</h3>
            <p class="mt-1 text-sm text-emerald-700 leading-relaxed">{t(lang, 'secretsPage.features.rbac.desc')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-emerald-950">
    <div class="max-w-4xl mx-auto px-6 py-24 text-center">
      <h2 class="text-4xl sm:text-5xl font-black text-emerald-50 tracking-tight">{t(lang, 'secretsPage.cta.title1')}<br /><span class="italic text-emerald-300">{t(lang, 'secretsPage.cta.title2')}</span></h2>
      <p class="mt-4 text-lg text-emerald-400">{t(lang, 'secretsPage.cta.subtitle')}</p>
      <a href="https://github.com/FerrFlow-Org/FerrFlow" class="mt-10 inline-block px-8 py-4 rounded-full bg-emerald-500 text-white font-medium text-lg hover:bg-emerald-400 transition-colors shadow-lg shadow-emerald-900/50">{t(lang, 'secretsPage.cta.button')}</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-emerald-50 border-t border-emerald-100">
    <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-emerald-500">
      <span class="font-bold text-emerald-800 tracking-tight">Ferr<span class="text-emerald-500">Flow</span></span>
      <span>&copy; 2026 FerrFlow. All rights reserved.</span>
      <nav class="flex gap-6">
        <a href="/fr/docs/introduction" class="hover:text-emerald-800 transition-colors">{t(lang, 'footer.documentation')}</a>
        <a href="https://github.com/FerrFlow-Org/FerrFlow" class="hover:text-emerald-800 transition-colors">GitHub</a>
      </nav>
    </div>
  </footer>
</Layout>

<style>
  .landing-header { position: sticky; top: 0; z-index: 50; background: var(--bg, rgba(236,253,245,0.9)); backdrop-filter: blur(4px); border-bottom: 1px solid var(--border, #D1FAE5); }
  .landing-header:not(.no-transition) { animation: header-fill 0.9s cubic-bezier(0.4,0,0.2,1) forwards; }
  .landing-header-inner { max-width: 72rem; margin: 0 auto; padding: 0 1.5rem; height: 4rem; display: flex; align-items: center; }
</style>
