<!-- ─── Metrics ──────────────────────────────────────────── -->
<section class="py-20 border-t border-primary-100 bg-white">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="text-4xl sm:text-5xl font-black text-primary-950 tracking-tight">{t(lang, 'metrics.title')}</h2>
      <p class="mt-4 text-lg text-primary-700 font-normal">{t(lang, 'metrics.subtitle')}</p>
    </div>
    <div class="grid grid-cols-3 gap-6" id="stats">
      <div class="text-center p-6 rounded-2xl border border-primary-100 opacity-0 animate-fade-up" style="animation-delay: 0ms; box-shadow: 0 4px 24px rgba(232,115,58,0.07);">
        <div class="text-4xl sm:text-5xl font-black text-primary-600 tracking-tight" data-stat="total_releases">0</div>
        <div class="mt-2 text-sm text-primary-700 font-medium">{t(lang, 'metrics.releases')}</div>
      </div>
      <div class="text-center p-6 rounded-2xl border border-primary-100 opacity-0 animate-fade-up" style="animation-delay: 80ms; box-shadow: 0 4px 24px rgba(232,115,58,0.07);">
        <div class="text-4xl sm:text-5xl font-black text-primary-600 tracking-tight" data-stat="total_repos">0</div>
        <div class="mt-2 text-sm text-primary-700 font-medium">{t(lang, 'metrics.repos')}</div>
      </div>
      <div class="text-center p-6 rounded-2xl border border-primary-100 opacity-0 animate-fade-up" style="animation-delay: 160ms; box-shadow: 0 4px 24px rgba(232,115,58,0.07);">
        <div class="text-4xl sm:text-5xl font-black text-primary-600 tracking-tight" data-stat="total_commits_analyzed">0</div>
        <div class="mt-2 text-sm text-primary-700 font-medium">{t(lang, 'metrics.commits')}</div>
      </div>
    </div>
  </div>
</section>

<script>
  const API_URL = 'https://api.ferrflow.com';
  const ANIMATION_DURATION = 800;
  const activeAnimations = new Map<string, number>();

  function animateValue(el: Element, from: number, to: number) {
    const key = el.getAttribute('data-stat') ?? '';
    const prev = activeAnimations.get(key);
    if (prev) cancelAnimationFrame(prev);

    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min((now - start) / ANIMATION_DURATION, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      const current = Math.round(from + (to - from) * eased);
      el.textContent = current.toLocaleString();
      if (t < 1) {
        activeAnimations.set(key, requestAnimationFrame(step));
      } else {
        activeAnimations.delete(key);
      }
    };
    activeAnimations.set(key, requestAnimationFrame(step));
  }

  function updateStats(data: Record<string, unknown>) {
    for (const [key, value] of Object.entries(data)) {
      const el = document.querySelector(`[data-stat="${key}"]`);
      if (!el) continue;
      const to = Number(value);
      const from = Number(el.textContent?.replace(/\D/g, '') || '0');
      if (from === to) continue;
      animateValue(el, from, to);
    }
  }

  async function fetchStats() {
    try {
      const res = await fetch(`${API_URL}/stats`);
      if (!res.ok) return;
      updateStats(await res.json());
    } catch {
      // Keep fallback values
    }
  }

  function connectStatsStream() {
    const source = new EventSource(`${API_URL}/stats/stream?interval=5`);

    source.addEventListener('stats', (e) => {
      try {
        updateStats(JSON.parse(e.data));
      } catch {
        // Ignore malformed events
      }
    });

    source.addEventListener('error', () => {
      source.close();
    });
  }

  fetchStats();
  connectStatsStream();
</script>

<!-- ─── Features ──────────────────────────────────────────── -->
<section class="py-28 bg-white border-t border-primary-100">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl sm:text-5xl font-black text-primary-950 tracking-tight">{t(lang, 'features.title')}</h2>
      <p class="mt-4 text-lg text-primary-700 font-normal">{t(lang, 'features.subtitle')}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
