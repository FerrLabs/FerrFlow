---
import type { Props } from '@astrojs/starlight/props';
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from './ThemeSelect.astro';
---

<div class="header sl-flex">
  <div class="title-wrapper">
    <a href="/" class="site-title sl-flex">
      <img src="/favicon.svg" alt="FerrFlow Logo" class="logo" />
      <span class="text">
        Ferr<span class="highlight">Flow</span>
      </span>
    </a>
  </div>
  <div class="sl-flex sl-hidden md:sl-flex right-group">
    <div class="sl-flex social-icons">
      <Search {...Astro.props} />
      <SocialIcons {...Astro.props} />
      <ThemeSelect {...Astro.props} />
    </div>
  </div>
</div>

<style>
  .header {
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    flex-shrink: 0;
    font-weight: 900;
    font-size: var(--sl-text-h4);
    color: var(--sl-color-text);
    line-height: 1;
  }

  .site-title {
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
  }

  .logo {
    width: 2rem;
    height: 2rem;
  }

  .text {
    font-size: 1.25rem;
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .highlight {
    color: var(--sl-color-text-accent);
  }

  .right-group {
    gap: 1rem;
    align-items: center;
  }

  .social-icons {
    gap: 0.5rem;
    align-items: center;
  }

  .social-icons :global(a) {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .right-group :global(a) {
    color: var(--sl-color-text);
    text-decoration: none;
  }

  @media (min-width: 50rem) {
    .header {
      --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
      --__main-column-fr: calc(
        (
            100% + var(--__sidebar-pad) -
              var(--__mobile-toc-overflow) - (2 * var(--sl-content-pad-x))
          ) * 999
      );

      display: flex;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
