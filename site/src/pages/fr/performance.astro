---
import Layout from '../../layouts/Layout.astro';
import benchmarks from '../../data/benchmarks.json';

type Cell = { median_ms: number; stddev_ms: number; memory_mb: string | number };
type InstallSize = { npm?: string; binary?: string };

const KNOWN_TOOLS = [
  'commit-and-tag-version',
  'standard-version',
  'semantic-release',
  'release-please',
  'changesets',
  'ferrflow',
];

const FIXTURE_LABELS: Record<string, string> = {
  single: 'Paquet unique',
  'mono-small': 'Monorepo · petit (5 paquets)',
  'mono-medium': 'Monorepo · moyen (20 paquets)',
  'mono-large': 'Monorepo · grand (50 paquets)',
  'mono-50-5k': 'Monorepo · 50 paquets × 5k commits',
  'mono-100-1k': 'Monorepo · 100 paquets × 1k commits',
};

const COMMAND_LABELS: Record<string, string> = {
  check: 'check',
  'release-dry-run': 'release --dry-run',
  tag: 'tag',
  validate: 'validate',
  version: 'version',
};

interface Parsed {
  fixture: string;
  tool: string;
  method: string;
  cmd: string;
}

function parseKey(key: string): Parsed | null {
  for (const tool of KNOWN_TOOLS) {
    const marker = `-${tool}-`;
    const idx = key.indexOf(marker);
    if (idx < 0) continue;
    const fixture = key.slice(0, idx);
    const rest = key.slice(idx + marker.length);
    const [method, ...cmdParts] = rest.split('-');
    return { fixture, tool, method, cmd: cmdParts.join('-') };
  }
  return null;
}

const data = benchmarks.benchmarks as Record<string, Cell>;
const fixtures = new Set<string>();
const tools = new Set<string>();
const commands = new Set<string>();
const grid: Record<string, Cell> = {};

const PREFERRED_METHOD: Record<string, string> = { ferrflow: 'binary' };
const preferredMethod = (tool: string) => PREFERRED_METHOD[tool] ?? 'npm';

for (const [key, cell] of Object.entries(data)) {
  const p = parseKey(key);
  if (!p) continue;
  if (p.method !== preferredMethod(p.tool)) continue;
  fixtures.add(p.fixture);
  tools.add(p.tool);
  if (p.cmd) commands.add(p.cmd);
  grid[`${p.fixture}|${p.tool}|${p.cmd}`] = cell;
}

const orderedFixtures = Array.from(fixtures).sort((a, b) => {
  const order = Object.keys(FIXTURE_LABELS);
  return order.indexOf(a) - order.indexOf(b);
});
const orderedTools = Array.from(tools).sort((a, b) => {
  if (a === 'ferrflow') return -1;
  if (b === 'ferrflow') return 1;
  return a.localeCompare(b);
});
const orderedCommands = Array.from(commands).sort();
const hasCompetitors = orderedTools.length > 1;

const installSizes =
  (benchmarks as unknown as { install_sizes?: Record<string, InstallSize> }).install_sizes ?? {};
const installSizeTools = Object.keys(installSizes).sort((a, b) => {
  if (a === 'ferrflow') return -1;
  if (b === 'ferrflow') return 1;
  return a.localeCompare(b);
});
const hasInstallSizes = installSizeTools.length > 0;

type ParallelCell = { median_ms: number; stddev_ms: number };
const parallelData =
  (benchmarks as unknown as { ferrflow_parallel?: Record<string, ParallelCell> })
    .ferrflow_parallel ?? {};
const runnerCores = (benchmarks as unknown as { runner_cores?: number }).runner_cores ?? null;
const PARALLEL_CMD = 'release-dry-run';

function parseParallelKey(key: string): { fixture: string; cmd: string } | null {
  for (const fixture of orderedFixtures) {
    if (key.startsWith(`${fixture}-`)) return { fixture, cmd: key.slice(fixture.length + 1) };
  }
  return null;
}

const parallelRows = Object.entries(parallelData)
  .map(([key, cell]) => {
    const p = parseParallelKey(key);
    if (!p || p.cmd !== PARALLEL_CMD) return null;
    const single = grid[`${p.fixture}|ferrflow|${p.cmd}`];
    if (!single) return null;
    return { fixture: p.fixture, single, parallel: cell };
  })
  .filter((r): r is { fixture: string; single: Cell; parallel: ParallelCell } => r !== null)
  .sort((a, b) => orderedFixtures.indexOf(a.fixture) - orderedFixtures.indexOf(b.fixture));

const hasParallel = parallelRows.length > 0 && runnerCores !== null && runnerCores > 1;

function speedup(single: Cell, parallel: ParallelCell): string {
  if (parallel.median_ms <= 0) return '—';
  return `${(single.median_ms / parallel.median_ms).toFixed(1)}×`;
}

function fmtSize(v: string | undefined): string {
  if (!v || v === 'N/A') return '—';
  return `${v} Mo`;
}

function fmt(cell: Cell | undefined): string {
  if (!cell) return '—';
  if (cell.median_ms < 1) return `${(cell.median_ms * 1000).toFixed(0)} µs`;
  if (cell.median_ms < 1000) return `${cell.median_ms.toFixed(0)} ms`;
  return `${(cell.median_ms / 1000).toFixed(2)} s`;
}

const FIXTURE_SHORT: Record<string, string> = {
  single: 'Single',
  'mono-small': 'Mono · 5',
  'mono-medium': 'Mono · 20',
  'mono-large': 'Mono · 50',
  'mono-50-5k': '50 × 5k',
  'mono-100-1k': '100 × 1k',
};

const TOOL_COLORS: Record<string, string> = {
  ferrflow: '#e8733a',
  changesets: '#94a3b8',
  'commit-and-tag-version': '#b8c2cf',
  'standard-version': '#cbd5e1',
  'semantic-release': '#7c8a9c',
  'release-please': '#a3b1c2',
};

const chartData: Record<string, Record<string, Record<string, number>>> = {};
for (const fix of orderedFixtures) {
  for (const cmd of orderedCommands) {
    const row: Record<string, number> = {};
    for (const tool of orderedTools) {
      const cell = grid[`${fix}|${tool}|${cmd}`];
      if (cell) row[tool] = cell.median_ms;
    }
    if (Object.keys(row).length > 0) {
      (chartData[fix] ??= {})[cmd] = row;
    }
  }
}

const defaultCmd = orderedCommands.includes('check') ? 'check' : (orderedCommands[0] ?? 'check');

const chartConfig = {
  data: chartData,
  fixtures: orderedFixtures,
  commands: orderedCommands,
  tools: orderedTools,
  fixtureShort: FIXTURE_SHORT,
  commandLabels: COMMAND_LABELS,
  toolColors: TOOL_COLORS,
  defaultCmd,
};

const hasChart = Object.keys(chartData).length > 0;

const updated = new Date(benchmarks.timestamp).toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout
  title="Performance — FerrFlow"
  description="Comment FerrFlow se compare à semantic-release, changesets, standard-version et commit-and-tag-version sur des fixtures réelles. Latence médiane, RSS, taille d'install — mesurés via hyperfine en CI."
  canonical="https://ferrflow.com/fr/performance"
  pathname="/fr/performance"
  lang="fr"
>
  <main class="perf-main">
    <header class="perf-header">
      <p class="eyebrow">Benchmarks</p>
      <h1>À quel point <em>FerrFlow</em> est rapide ?</h1>
      <p class="lead">
        Comparaison côte-à-côte avec les outils de release de l'écosystème JavaScript, mesurée avec <a
          href="https://github.com/sharkdp/hyperfine">hyperfine</a
        > sur le même matériel, les mêmes commits, les mêmes fixtures. Les chiffres se rafraîchissent
        à chaque release FerrFlow.
      </p>
      <p class="updated">
        Dernière mise à jour : <strong>{updated}</strong> · ferrflow
        <code>{benchmarks.ferrflow_version.replace('ferrflow ', 'v')}</code> · binaire
        <code>{benchmarks.ferrflow_binary_size_mb} Mo</code>
      </p>
    </header>

    {
      !hasCompetitors && (
        <aside class="perf-note">
          <strong>Note.</strong> Ce snapshot a été capturé avant l'activation des benchmarks
          concurrents en CI. Seules les lignes FerrFlow apparaissent pour l'instant. La prochaine
          release après <a href="https://github.com/FerrLabs/FerrFlow/pull/451">FerrFlow#451</a>
          peuplera automatiquement les lignes de comparaison.
        </aside>
      )
    }

    {
      hasChart && (
        <section class="perf-chart" aria-label="Comparaison de latence par commande">
          <div class="perf-pills" id="perf-cmd">
            {orderedCommands.map((c) => (
              <button class:list={['perf-pill', { 'is-active': c === defaultCmd }]} data-cmd={c}>
                {COMMAND_LABELS[c] ?? c}
              </button>
            ))}
          </div>
          <div class="perf-legend" id="perf-legend" />
          <div class="perf-canvas-wrap">
            <canvas
              id="perf-canvas"
              role="img"
              aria-label="Diagramme à barres groupées de la latence médiane par fixture et par outil, échelle logarithmique"
            />
          </div>
          <p class="perf-chart-note">
            Médiane de 10 runs hyperfine · échelle log · FerrFlow épinglé à <code>--jobs 1</code> ·
            plus c'est bas, mieux c'est
          </p>
          <table class="sr-only">
            <caption>Latence médiane, {COMMAND_LABELS[defaultCmd] ?? defaultCmd}</caption>
            <thead>
              <tr>
                <th>Outil</th>
                {orderedFixtures.map((f) => (
                  <th>{FIXTURE_SHORT[f] ?? f}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {orderedTools.map((tool) => (
                <tr>
                  <th>{tool}</th>
                  {orderedFixtures.map((f) => (
                    <td>{fmt(grid[`${f}|${tool}|${defaultCmd}`])}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          <script
            type="application/json"
            id="perf-chart-data"
            set:html={JSON.stringify(chartConfig)}
          />
          <script>import '../../scripts/perf-chart.ts';</script>
        </section>
      )
    }

    <section class="perf-method">
      <h2>Méthodologie</h2>
      <ul>
        <li>
          <strong>Hyperfine</strong> avec 3 runs de warmup et 10 runs mesurés par cellule (fixture × outil
          × commande). Latence médiane reportée.
        </li>
        <li>
          <strong>Peak RSS</strong> via <code>/usr/bin/time -v</code> sur un run additionnel.
        </li>
        <li>
          <strong>Fixtures</strong> générées via
          <a href="https://github.com/FerrLabs/Fixtures">FerrLabs/Fixtures</a> avec un historique de commits
          conventionnels déterministe (aucune entrée flaky).
        </li>
        <li>
          <strong>Toutes les commandes</strong> sont des dry-runs no-op :
          <code>ferrflow check</code>, <code>semantic-release --dry-run --no-ci</code>,
          <code>changesets status</code>, <code>standard-version --dry-run</code>, etc. On compare
          donc le coût de planification, pas le coût IO de mutation.
        </li>
        <li>
          <strong>Comparaison mono-thread.</strong> FerrFlow tourne avec <code>--jobs 1</code> dans le
          graphique ci-dessus, pour être mesuré comme les outils JS mono-thread. Ses chiffres réels en
          parallèle sont reportés séparément.
        </li>
        <li>
          <strong>Reproductible</strong> — pipeline complet sur
          <a href="https://github.com/FerrLabs/Benchmarks">FerrLabs/Benchmarks</a> ; résultats publiés
          en artefacts à chaque push <code>main</code> et dans chaque release notes.
        </li>
      </ul>
    </section>

    {
      hasParallel && (
        <section class="perf-section">
          <h2>Mode parallèle</h2>
          <p class="lead">
            La comparaison fixe FerrFlow à un seul thread (<code>--jobs 1</code>) pour rester
            comparable aux outils JS mono-thread. En CI réelle, il utilise tous les cœurs — voici le
            même <code>release --dry-run</code> sur les {runnerCores} cœurs du runner de benchmark.
          </p>
          <div class="perf-table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Fixture</th>
                  <th>1 thread</th>
                  <th class="is-ours">{runnerCores} cœurs</th>
                  <th>Accélération</th>
                </tr>
              </thead>
              <tbody>
                {parallelRows.map((row) => (
                  <tr>
                    <td>{FIXTURE_LABELS[row.fixture] ?? row.fixture}</td>
                    <td>{fmt(row.single)}</td>
                    <td class="is-ours">{fmt(row.parallel as Cell)}</td>
                    <td>{speedup(row.single, row.parallel)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      hasInstallSizes && (
        <section class="perf-section">
          <h2>Empreinte d'installation</h2>
          <p class="perf-footprint-lead">
            Taille sur disque après installation. <code>release-please</code> n'apparaît qu'ici —
            son runtime ne peut pas être benché offline (il a besoin de l'API GitHub pour résoudre
            la dernière release), donc l'empreinte est la seule comparaison équitable qu'on peut
            publier.
          </p>
          <div class="perf-table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Outil</th>
                  <th>npm install</th>
                  <th>Binaire natif</th>
                </tr>
              </thead>
              <tbody>
                {installSizeTools.map((tool) => (
                  <tr>
                    <th class="fix-label">{tool}</th>
                    <td class:list={{ 'is-ours': tool === 'ferrflow' }}>
                      <span class="lat">{fmtSize(installSizes[tool].npm)}</span>
                    </td>
                    <td class:list={{ 'is-ours': tool === 'ferrflow' }}>
                      <span class="lat">{fmtSize(installSizes[tool].binary)}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <section class="perf-footnote">
      <h2>Pourquoi FerrFlow produit des chiffres plus petits</h2>
      <ul>
        <li>
          <strong>Binaire natif.</strong> Pas de boot Node.js, pas de npm install, pas de découverte de
          plugins. Un <code>ferrflow check</code> sur un monorepo de 50 paquets termine avant que <code
            >node --version</code
          > aurait fini de chauffer.
        </li>
        <li>
          <strong>libgit2 in-process.</strong> Énumération des tags et walking des commits via libgit2
          dans le même process. Les concurrents shell-out à <code>git</code> à chaque appel ; le coût
          de spawn domine sur les historiques denses.
        </li>
        <li>
          <strong>Un seul outil, pas un arbre de plugins.</strong> semantic-release charge une chaîne
          d'analyseurs, générateurs de notes, publishers npm et writers de changelog — chacun avec son
          coût de require(). Le pipeline FerrFlow tient dans une seule crate Rust.
        </li>
      </ul>
      <p class="cta">
        Chiffres mis à jour à chaque release. Voir les
        <a href="https://github.com/FerrLabs/FerrFlow/releases/latest"
          >notes de la dernière release</a
        >
        pour la table complète avec delta de baseline.
      </p>
    </section>
  </main>

  <style>
    .perf-main {
      max-width: 1080px;
      margin: 0 auto;
      padding: 64px 24px 96px;
      color: #1e293b;
    }
    .perf-header {
      margin-bottom: 56px;
    }
    .eyebrow {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #64748b;
      margin: 0 0 12px;
    }
    h1 {
      font-size: clamp(40px, 5vw, 64px);
      line-height: 1.05;
      letter-spacing: -0.025em;
      margin: 0 0 20px;
      font-weight: 700;
    }
    h1 em {
      font-style: italic;
      color: #e8733a;
      font-weight: 600;
    }
    .lead {
      font-size: 18px;
      line-height: 1.55;
      color: #475569;
      max-width: 680px;
    }
    .lead a {
      color: #b8470f;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
    .updated {
      margin-top: 20px;
      font-size: 13px;
      color: #64748b;
    }
    .updated code {
      font-size: 12px;
      background: #f1f5f9;
      padding: 2px 6px;
      border-radius: 3px;
      color: #1e293b;
    }
    .perf-note {
      padding: 18px 22px;
      background: #fef3c7;
      border-left: 3px solid #f59e0b;
      border-radius: 4px;
      font-size: 14px;
      color: #78350f;
      margin: 0 0 48px;
    }
    .perf-note a {
      color: #b45309;
      font-weight: 600;
    }
    .perf-method,
    .perf-footnote {
      margin-bottom: 56px;
    }
    .perf-method h2,
    .perf-section h2,
    .perf-footnote h2 {
      font-size: 24px;
      letter-spacing: -0.015em;
      font-weight: 700;
      margin: 0 0 18px;
    }
    .perf-method h2 code,
    .perf-section h2 code,
    .perf-footnote h2 code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 20px;
      background: #fef3ec;
      color: #b8470f;
      padding: 2px 10px;
      border-radius: 4px;
    }
    .perf-method ul,
    .perf-footnote ul {
      padding-left: 20px;
      margin: 0 0 16px;
    }
    .perf-method li,
    .perf-footnote li {
      margin-bottom: 10px;
      line-height: 1.6;
      color: #334155;
    }
    .perf-method code,
    .perf-footnote code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 13px;
      background: #f1f5f9;
      padding: 1px 5px;
      border-radius: 3px;
      color: #1e293b;
    }
    .perf-method a,
    .perf-footnote a {
      color: #b8470f;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }
    .perf-section {
      margin-bottom: 40px;
    }
    .perf-table-wrap {
      overflow-x: auto;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    thead th {
      text-align: left;
      padding: 12px 14px;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      font-weight: 600;
      color: #475569;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      letter-spacing: 0.02em;
    }
    thead th.is-ours {
      color: #e8733a;
    }
    tbody th.fix-label {
      text-align: left;
      padding: 12px 14px;
      font-weight: 500;
      color: #1e293b;
      border-bottom: 1px solid #f1f5f9;
      white-space: nowrap;
    }
    tbody td {
      padding: 12px 14px;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: top;
    }
    tbody tr:last-child th,
    tbody tr:last-child td {
      border-bottom: none;
    }
    tbody td.is-ours {
      background: rgba(232, 115, 58, 0.06);
    }
    tbody td.is-empty {
      color: #94a3b8;
    }
    .lat {
      display: block;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-weight: 600;
      color: #1e293b;
    }
    td.is-ours .lat {
      color: #b8470f;
    }
    .mem {
      display: block;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      color: #94a3b8;
      margin-top: 2px;
    }
    .cta {
      margin-top: 12px;
      font-size: 14px;
      color: #475569;
    }
    .cta a {
      color: #b8470f;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    @media (max-width: 720px) {
      .perf-main {
        padding: 48px 16px 64px;
      }
      table {
        font-size: 13px;
      }
      thead th,
      tbody th.fix-label,
      tbody td {
        padding: 10px 8px;
      }
    }
  </style>

  <style is:global>
    .perf-chart {
      margin-bottom: 56px;
    }
    .perf-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 16px;
    }
    .perf-pill {
      font-family: inherit;
      font-size: 14px;
      padding: 6px 14px;
      border-radius: 999px;
      border: 1px solid #e2e8f0;
      background: #fff;
      color: #475569;
      cursor: pointer;
      transition:
        border-color 0.12s,
        background 0.12s,
        color 0.12s;
    }
    .perf-pill:hover {
      border-color: #cbd5e1;
    }
    .perf-pill.is-active {
      border-color: #e8733a;
      background: rgba(232, 115, 58, 0.1);
      color: #e8733a;
      font-weight: 500;
    }
    .perf-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 14px;
      font-size: 12px;
      color: #64748b;
    }
    .perf-leg {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .perf-leg-dot {
      width: 10px;
      height: 10px;
      border-radius: 2px;
      display: inline-block;
    }
    .perf-canvas-wrap {
      position: relative;
      width: 100%;
      height: 380px;
    }
    .perf-chart-note {
      font-size: 12px;
      color: #94a3b8;
      margin: 16px 0 0;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>
</Layout>
