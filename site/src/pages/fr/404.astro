---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="404 — FerrFlow"
  description="Cette page n'existe pas."
  lang="fr"
  canonical="https://ferrflow.com/fr/404"
  pathname="/fr/404"
>
  <section class="error-page">
    <p class="kicker">Erreur 404</p>
    <h1>Page introuvable</h1>
    <p class="lede">La route demandée n'existe pas sur ferrflow.com.</p>
    <ul class="links">
      <li><a href="/fr/">← Retour à ferrflow.com</a></li>
      <li><a href="/fr/docs/introduction/">Lire la doc</a></li>
      <li><a href="https://github.com/FerrLabs/FerrFlow/releases">Dernières releases</a></li>
    </ul>
  </section>
</Layout>

<style>
  .error-page {
    max-width: 560px;
    margin: 0 auto;
    padding: 96px 24px;
    text-align: center;
    color: var(--color-ink-2, #475569);
  }
  .kicker {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-ink-3, #94a3b8);
    margin: 0 0 18px;
  }
  h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-ink, #0f172a);
    margin: 0 0 16px;
    line-height: 1.05;
  }
  .lede {
    font-size: 16px;
    margin: 0 0 32px;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .links a {
    color: #e8733a;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
