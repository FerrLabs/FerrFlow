{
  "bin": {
    "ferrflow": "./bin/ferrflow.js"
  },
  "description": "Universal semantic versioning for monorepos and classic repos",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "index.js",
    "index.d.ts",
    "types"
  ],
  "homepage": "https://ferrflow.com",
  "keywords": [
    "semver",
    "versioning",
    "monorepo",
    "changelog",
    "release"
  ],
  "license": "MIT",
  "main": "./index.js",
  "name": "ferrflow",
  "optionalDependencies": {
    "@ferrflow/darwin-arm64": "7.32.0",
    "@ferrflow/darwin-x64": "7.32.0",
    "@ferrflow/linux-arm": "7.32.0",
    "@ferrflow/linux-arm64": "7.32.0",
    "@ferrflow/linux-x64": "7.32.0",
    "@ferrflow/win32-arm64": "7.32.0",
    "@ferrflow/win32-x64": "7.32.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FerrLabs/FerrFlow.git"
  },
  "type": "module",
  "types": "./index.d.ts",
  "version": "7.32.0"
}
