---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { t, type Lang } from '../i18n/translations';

const lang: Lang = Astro.url.pathname.startsWith('/fr/') ? 'fr' : 'en';
---

<Layout title={t(lang, 'pricing.meta.title')} description={t(lang, 'pricing.meta.description')} lang={lang}>
  <header class="landing-header"><div class="landing-header-inner"><Navbar lang={lang} activePage="home" /></div></header>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-primary-50">
    <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[600px] rounded-full opacity-40" style="background: radial-gradient(ellipse, #FFCBA4 0%, #FFE8D2 40%, transparent 70%);"></div>
    <div class="relative max-w-5xl mx-auto px-6 pt-24 pb-20">
      <h1 class="text-center font-black text-primary-950 tracking-tight leading-[0.95]">
        <span class="block text-7xl sm:text-8xl md:text-[7rem] lg:text-[8.5rem]">{t(lang, 'pricing.hero.headline1')}</span>
        <span class="block text-7xl sm:text-8xl md:text-[7rem] lg:text-[8.5rem] italic text-primary-600">{t(lang, 'pricing.hero.headline2')}</span>
      </h1>
      <p class="mt-8 text-center text-lg sm:text-xl text-primary-700 max-w-2xl mx-auto leading-relaxed">
        {t(lang, 'pricing.hero.subheading')}
      </p>
    </div>
  </section>

  <!-- Plans -->
  <section class="py-20 bg-white border-t border-primary-100">
    <div class="max-w-5xl mx-auto px-6">

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Free -->
        <div class="rounded-2xl border border-primary-200 bg-white p-8 flex flex-col">
          <h3 class="text-xl font-bold text-primary-950">{t(lang, 'pricing.free.name')}</h3>
          <div class="mt-4 mb-6">
            <span class="text-4xl font-black text-primary-950">{t(lang, 'pricing.free.price')}</span>
            <span class="text-primary-500 text-sm ml-1">{t(lang, 'pricing.free.unit')}</span>
          </div>
          <ul class="space-y-2.5 text-sm text-primary-700 mb-8 flex-1">
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.free.f1')}</li>
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.free.f2')}</li>
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.free.f3')}</li>
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.free.f4')}</li>
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.free.f5')}</li>
          </ul>
          <a href="https://github.com/FerrFlow-Org/FerrFlow/releases/latest" class="block text-center py-2.5 rounded-lg border border-primary-300 text-primary-800 font-medium text-sm hover:bg-primary-100 transition-colors">{t(lang, 'pricing.free.cta')}</a>
        </div>

        <!-- Team -->
        <div class="rounded-2xl border-2 border-primary-400 bg-white p-8 flex flex-col relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 bg-primary-600 text-white text-xs font-medium rounded-full">{t(lang, 'pricing.team.badge')}</div>
          <h3 class="text-xl font-bold text-primary-950">{t(lang, 'pricing.team.name')}</h3>
          <div class="mt-4 mb-6">
            <span class="text-4xl font-black text-primary-950">{t(lang, 'pricing.team.price')}</span>
            <span class="text-primary-500 text-sm ml-1">{t(lang, 'pricing.team.unit')}</span>
          </div>
          <ul class="space-y-2.5 text-sm text-primary-700 mb-8 flex-1">
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.team.f1')}</li>
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.team.f2')}</li>
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.team.f3')}</li>
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.team.f4')}</li>
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.team.f5')}</li>
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.team.f6')}</li>
          </ul>
          <a href="https://app.ferrflow.com/signup" class="block text-center py-2.5 rounded-lg bg-primary-600 text-white font-medium text-sm hover:bg-primary-700 transition-colors">{t(lang, 'pricing.team.cta')}</a>
        </div>

        <!-- Business -->
        <div class="rounded-2xl border border-primary-200 bg-white p-8 flex flex-col">
          <h3 class="text-xl font-bold text-primary-950">{t(lang, 'pricing.business.name')}</h3>
          <div class="mt-4 mb-6">
            <span class="text-4xl font-black text-primary-950">{t(lang, 'pricing.business.price')}</span>
            <span class="text-primary-500 text-sm ml-1">{t(lang, 'pricing.business.unit')}</span>
          </div>
          <ul class="space-y-2.5 text-sm text-primary-700 mb-8 flex-1">
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.business.f1')}</li>
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.business.f2')}</li>
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.business.f3')}</li>
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.business.f4')}</li>
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.business.f5')}</li>
            <li class="flex gap-2"><span class="text-primary-600 mt-0.5">&#10003;</span> {t(lang, 'pricing.business.f6')}</li>
          </ul>
          <a href="https://app.ferrflow.com/signup" class="block text-center py-2.5 rounded-lg border border-primary-300 text-primary-800 font-medium text-sm hover:bg-primary-100 transition-colors">{t(lang, 'pricing.business.cta')}</a>
        </div>
      </div>

      <div class="mt-8 p-4 rounded-xl bg-primary-100/50 text-center">
        <p class="text-sm text-primary-700"><strong>{t(lang, 'pricing.selfhosted.prefix')}</strong>{t(lang, 'pricing.selfhosted.body')}<a href={lang === 'fr' ? '/fr/docs/introduction' : '/docs/introduction'} class="text-primary-600 underline hover:text-primary-800">{t(lang, 'pricing.selfhosted.link')}</a></p>
      </div>
    </div>
  </section>

  <!-- Compare plans -->
  <section class="py-20 bg-primary-50 border-t border-primary-100">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl sm:text-4xl font-black text-primary-950 text-center tracking-tight mb-12">{t(lang, 'pricing.compare.title')}</h2>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-primary-200">
              <th class="text-left py-3 pr-4 font-medium text-primary-500 w-1/4"></th>
              <th class="text-center py-3 px-4 font-bold text-primary-950">{t(lang, 'pricing.free.name')}</th>
              <th class="text-center py-3 px-4 font-bold text-primary-600">{t(lang, 'pricing.team.name')}</th>
              <th class="text-center py-3 px-4 font-bold text-primary-950">{t(lang, 'pricing.business.name')}</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-primary-100 bg-primary-50/50">
              <td class="py-3 pr-4 font-bold text-primary-900"><div class="flex items-center gap-2"><div class="w-4 h-4 rounded bg-primary-100 flex items-center justify-center shrink-0"><svg class="w-2.5 h-2.5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3" /></svg></div>{t(lang, 'pricing.compare.cli')}</div></td>
              <td></td><td></td><td></td>
            </tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.versioning')}</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.monorepo')}</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.prPreview')}</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.insights')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.retention')}</td><td class="text-center text-primary-500">{t(lang, 'pricing.row.retention.free')}</td><td class="text-center text-primary-500">{t(lang, 'pricing.row.retention.team')}</td><td class="text-center text-primary-500">{t(lang, 'pricing.row.retention.business')}</td></tr>

            <tr class="border-b border-indigo-200 bg-indigo-50/50">
              <td class="py-3 pr-4 font-bold text-primary-900"><div class="flex items-center gap-2"><div class="w-4 h-4 rounded bg-indigo-100 flex items-center justify-center shrink-0"><svg class="w-2.5 h-2.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2" /></svg></div>{t(lang, 'pricing.compare.issues')}</div></td>
              <td></td><td></td><td></td>
            </tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.orgs')}</td><td class="text-center text-primary-500">1</td><td class="text-center text-primary-500">5</td><td class="text-center text-primary-500">{t(lang, 'pricing.row.unlimited')}</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.projects')}</td><td class="text-center text-primary-500">3</td><td class="text-center text-primary-500">20</td><td class="text-center text-primary-500">{t(lang, 'pricing.row.unlimited')}</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.members')}</td><td class="text-center text-primary-500">5</td><td class="text-center text-primary-500">15</td><td class="text-center text-primary-500">{t(lang, 'pricing.row.unlimited')}</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.dashboard')}</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.webhooks')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.templates')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.export')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.sso')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.customFields')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td></tr>

            <tr class="border-b border-emerald-200 bg-emerald-50/50">
              <td class="py-3 pr-4 font-bold text-primary-900"><div class="flex items-center gap-2"><div class="w-4 h-4 rounded bg-emerald-100 flex items-center justify-center shrink-0"><svg class="w-2.5 h-2.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg></div>{t(lang, 'pricing.compare.secrets')}</div></td>
              <td></td><td></td><td></td>
            </tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.secretsPerProject')}</td><td class="text-center text-primary-500">10</td><td class="text-center text-primary-500">{t(lang, 'pricing.row.unlimited')}</td><td class="text-center text-primary-500">{t(lang, 'pricing.row.unlimited')}</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.ciInjection')}</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.rotation')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.crossProject')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.ipAllowlist')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.granularRbac')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.sla')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.audit')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td></tr>

            <tr class="border-b border-rose-200 bg-rose-50/50">
              <td class="py-3 pr-4 font-bold text-primary-900"><div class="flex items-center gap-2"><div class="w-4 h-4 rounded bg-rose-100 flex items-center justify-center shrink-0"><svg class="w-2.5 h-2.5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg></div>{t(lang, 'pricing.compare.ai')}</div></td>
              <td></td><td></td><td></td>
            </tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.classification')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.summaries')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.priority')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.velocity')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>

            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.rateLimit')}</td><td class="text-center text-primary-500">60/min</td><td class="text-center text-primary-500">300/min</td><td class="text-center text-primary-500">600/min</td></tr>
            <tr class="border-b border-primary-100 bg-primary-50/30">
              <td class="py-3 pr-4 font-bold text-primary-900"><div class="flex items-center gap-2"><div class="w-4 h-4 rounded bg-primary-100 flex items-center justify-center shrink-0"><svg class="w-2.5 h-2.5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" /></svg></div>{t(lang, 'pricing.compare.support')}</div></td>
              <td></td><td></td><td></td>
            </tr>
            <tr class="border-b border-primary-50"><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.community')}</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
            <tr><td class="py-2 pr-4 text-primary-700">{t(lang, 'pricing.row.prioritySupport')}</td><td class="text-center text-primary-300">&mdash;</td><td class="text-center text-green-500">&#10003;</td><td class="text-center text-green-500">&#10003;</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary-950">
    <div class="max-w-4xl mx-auto px-6 py-24 text-center">
      <h2 class="text-4xl sm:text-5xl font-black text-primary-50 tracking-tight">{t(lang, 'pricing.cta.title')}</h2>
      <p class="mt-4 text-lg text-primary-400">{t(lang, 'pricing.cta.subtitle')}</p>
      <div class="mt-10 flex gap-4 justify-center">
        <a href="https://github.com/FerrFlow-Org/FerrFlow/releases/latest" class="px-8 py-4 rounded-full bg-primary-600 text-white font-medium text-lg hover:bg-primary-500 transition-colors shadow-lg shadow-primary-900/50">{t(lang, 'pricing.cta.start')}</a>
        <a href="https://github.com/FerrFlow-Org/FerrFlow/discussions" class="px-8 py-4 rounded-full border border-primary-700 text-primary-300 font-medium text-lg hover:border-primary-500 hover:text-primary-100 transition-colors">{t(lang, 'pricing.cta.talk')}</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-primary-50 border-t border-primary-100">
    <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-primary-500">
      <span class="font-bold text-primary-800 tracking-tight">Ferr<span class="text-primary-600">Flow</span></span>
      <span>&copy; 2026 FerrFlow. All rights reserved.</span>
      <nav class="flex gap-6">
        <a href={lang === 'fr' ? '/fr/docs/introduction' : '/docs/introduction'} class="hover:text-primary-800 transition-colors">{t(lang, 'footer.documentation')}</a>
        <a href="https://github.com/FerrFlow-Org/FerrFlow" class="hover:text-primary-800 transition-colors">GitHub</a>
      </nav>
    </div>
  </footer>
</Layout>

<style>
  .landing-header { position: sticky; top: 0; z-index: 50; background: var(--bg, rgba(255,248,242,0.9)); backdrop-filter: blur(4px); border-bottom: 1px solid var(--border, #ffe8d2); }
  .landing-header:not(.no-transition) { animation: header-fill 0.9s cubic-bezier(0.4,0,0.2,1) forwards; }
  .landing-header-inner { max-width: 72rem; margin: 0 auto; padding: 0 1.5rem; height: 4rem; display: flex; align-items: center; }
  details summary::-webkit-details-marker { display: none; }
  details summary { list-style: none; }
</style>
