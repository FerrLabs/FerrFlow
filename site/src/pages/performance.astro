---
import Layout from '../layouts/Layout.astro';
import benchmarks from '../data/benchmarks.json';

type Cell = { median_ms: number; stddev_ms: number; memory_mb: string | number };
type InstallSize = { npm?: string; binary?: string };

const KNOWN_TOOLS = [
  'commit-and-tag-version',
  'standard-version',
  'semantic-release',
  'release-please',
  'changesets',
  'ferrflow',
];

const FIXTURE_LABELS: Record<string, string> = {
  single: 'Single package',
  'mono-small': 'Monorepo · small (5 packages)',
  'mono-medium': 'Monorepo · medium (20 packages)',
  'mono-large': 'Monorepo · large (50 packages)',
  'mono-50-5k': 'Monorepo · 50 packages × 5k commits',
  'mono-100-1k': 'Monorepo · 100 packages × 1k commits',
};

const COMMAND_LABELS: Record<string, string> = {
  check: 'check',
  'release-dry-run': 'release --dry-run',
  tag: 'tag',
  validate: 'validate',
  version: 'version',
};

interface Parsed {
  fixture: string;
  tool: string;
  method: string;
  cmd: string;
}

function parseKey(key: string): Parsed | null {
  for (const tool of KNOWN_TOOLS) {
    const marker = `-${tool}-`;
    const idx = key.indexOf(marker);
    if (idx < 0) continue;
    const fixture = key.slice(0, idx);
    const rest = key.slice(idx + marker.length);
    const [method, ...cmdParts] = rest.split('-');
    return { fixture, tool, method, cmd: cmdParts.join('-') };
  }
  return null;
}

const data = benchmarks.benchmarks as Record<string, Cell>;
const fixtures = new Set<string>();
const tools = new Set<string>();
const commands = new Set<string>();
const grid: Record<string, Cell> = {};

const PREFERRED_METHOD: Record<string, string> = { ferrflow: 'binary' };
const preferredMethod = (tool: string) => PREFERRED_METHOD[tool] ?? 'npm';

for (const [key, cell] of Object.entries(data)) {
  const p = parseKey(key);
  if (!p) continue;
  if (p.method !== preferredMethod(p.tool)) continue;
  fixtures.add(p.fixture);
  tools.add(p.tool);
  if (p.cmd) commands.add(p.cmd);
  grid[`${p.fixture}|${p.tool}|${p.cmd}`] = cell;
}

const orderedFixtures = Array.from(fixtures).sort((a, b) => {
  const order = Object.keys(FIXTURE_LABELS);
  return order.indexOf(a) - order.indexOf(b);
});
const orderedTools = Array.from(tools).sort((a, b) => {
  if (a === 'ferrflow') return -1;
  if (b === 'ferrflow') return 1;
  return a.localeCompare(b);
});
const orderedCommands = Array.from(commands).sort();

const hasCompetitors = orderedTools.length > 1;

const installSizes =
  (benchmarks as unknown as { install_sizes?: Record<string, InstallSize> }).install_sizes ?? {};
const installSizeTools = Object.keys(installSizes).sort((a, b) => {
  if (a === 'ferrflow') return -1;
  if (b === 'ferrflow') return 1;
  return a.localeCompare(b);
});
const hasInstallSizes = installSizeTools.length > 0;

type ParallelCell = { median_ms: number; stddev_ms: number };
const parallelData =
  (benchmarks as unknown as { ferrflow_parallel?: Record<string, ParallelCell> })
    .ferrflow_parallel ?? {};
const runnerCores = (benchmarks as unknown as { runner_cores?: number }).runner_cores ?? null;
const PARALLEL_CMD = 'release-dry-run';

function parseParallelKey(key: string): { fixture: string; cmd: string } | null {
  for (const fixture of orderedFixtures) {
    if (key.startsWith(`${fixture}-`)) return { fixture, cmd: key.slice(fixture.length + 1) };
  }
  return null;
}

const parallelRows = Object.entries(parallelData)
  .map(([key, cell]) => {
    const p = parseParallelKey(key);
    if (!p || p.cmd !== PARALLEL_CMD) return null;
    const single = grid[`${p.fixture}|ferrflow|${p.cmd}`];
    if (!single) return null;
    return { fixture: p.fixture, single, parallel: cell };
  })
  .filter((r): r is { fixture: string; single: Cell; parallel: ParallelCell } => r !== null)
  .sort((a, b) => orderedFixtures.indexOf(a.fixture) - orderedFixtures.indexOf(b.fixture));

const hasParallel = parallelRows.length > 0 && runnerCores !== null && runnerCores > 1;

function speedup(single: Cell, parallel: ParallelCell): string {
  if (parallel.median_ms <= 0) return '—';
  return `${(single.median_ms / parallel.median_ms).toFixed(1)}×`;
}

function fmtSize(v: string | undefined): string {
  if (!v || v === 'N/A') return '—';
  return `${v} MB`;
}

const FIXTURE_SHORT: Record<string, string> = {
  single: 'Single',
  'mono-small': 'Mono · 5',
  'mono-medium': 'Mono · 20',
  'mono-large': 'Mono · 50',
  'mono-50-5k': '50 × 5k',
  'mono-100-1k': '100 × 1k',
};

const TOOL_COLORS: Record<string, string> = {
  ferrflow: '#e8733a',
  changesets: '#94a3b8',
  'commit-and-tag-version': '#b8c2cf',
  'standard-version': '#cbd5e1',
  'semantic-release': '#7c8a9c',
  'release-please': '#a3b1c2',
};

const chartData: Record<string, Record<string, Record<string, number>>> = {};
for (const fix of orderedFixtures) {
  for (const cmd of orderedCommands) {
    const row: Record<string, number> = {};
    for (const tool of orderedTools) {
      const cell = grid[`${fix}|${tool}|${cmd}`];
      if (cell) row[tool] = cell.median_ms;
    }
    if (Object.keys(row).length > 0) {
      (chartData[fix] ??= {})[cmd] = row;
    }
  }
}

const defaultCmd = orderedCommands.includes('check') ? 'check' : (orderedCommands[0] ?? 'check');

const chartConfig = {
  data: chartData,
  fixtures: orderedFixtures,
  commands: orderedCommands,
  tools: orderedTools,
  fixtureShort: FIXTURE_SHORT,
  commandLabels: COMMAND_LABELS,
  toolColors: TOOL_COLORS,
  defaultCmd,
};

const hasChart = Object.keys(chartData).length > 0;

function fmt(cell: Cell | undefined): string {
  if (!cell) return '—';
  if (cell.median_ms < 1) return `${(cell.median_ms * 1000).toFixed(0)} µs`;
  if (cell.median_ms < 1000) return `${cell.median_ms.toFixed(0)} ms`;
  return `${(cell.median_ms / 1000).toFixed(2)} s`;
}

const updated = new Date(benchmarks.timestamp).toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout
  title="Performance — FerrFlow"
  description="How FerrFlow compares to semantic-release, changesets, standard-version and commit-and-tag-version on real fixtures. Median latency, peak memory, install size — measured with hyperfine in CI."
  canonical="https://ferrflow.com/performance"
  pathname="/performance"
>
  <main class="perf-main">
    <header class="perf-header">
      <p class="eyebrow">Benchmarks</p>
      <h1>How fast is <em>FerrFlow</em>?</h1>
      <p class="lead">
        Side-by-side comparison against the JavaScript ecosystem release tools, measured with
        <a href="https://github.com/sharkdp/hyperfine">hyperfine</a> on the same hardware, the same commits,
        and the same fixtures. Numbers refresh on every FerrFlow release.
      </p>
      <p class="updated">
        Last update: <strong>{updated}</strong> · ferrflow <code
          >{benchmarks.ferrflow_version.replace('ferrflow ', 'v')}</code
        >
        · binary size <code>{benchmarks.ferrflow_binary_size_mb} MB</code>
      </p>
    </header>

    {
      !hasCompetitors && (
        <aside class="perf-note">
          <strong>Heads up.</strong> The snapshot below was captured before competitor benchmarks
          landed in CI. Only FerrFlow rows are shown for now. The next release after
          <a href="https://github.com/FerrLabs/FerrFlow/pull/451"> FerrFlow#451</a> will populate
          the comparison rows automatically.
        </aside>
      )
    }

    {
      hasChart && (
        <section class="perf-chart" aria-label="Latency comparison by command">
          <div class="perf-pills" id="perf-cmd">
            {orderedCommands.map((c) => (
              <button class:list={['perf-pill', { 'is-active': c === defaultCmd }]} data-cmd={c}>
                {COMMAND_LABELS[c] ?? c}
              </button>
            ))}
          </div>
          <div class="perf-legend" id="perf-legend" />
          <div class="perf-canvas-wrap">
            <canvas
              id="perf-canvas"
              role="img"
              aria-label="Grouped bar chart of median latency per fixture per tool, logarithmic scale"
            />
          </div>
          <p class="perf-chart-note">
            Median of 10 hyperfine runs · log scale · FerrFlow pinned to <code>--jobs 1</code> ·
            lower is better
          </p>
          <table class="sr-only">
            <caption>Median latency, {COMMAND_LABELS[defaultCmd] ?? defaultCmd}</caption>
            <thead>
              <tr>
                <th>Tool</th>
                {orderedFixtures.map((f) => (
                  <th>{FIXTURE_SHORT[f] ?? f}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {orderedTools.map((tool) => (
                <tr>
                  <th>{tool}</th>
                  {orderedFixtures.map((f) => (
                    <td>{fmt(grid[`${f}|${tool}|${defaultCmd}`])}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          <script
            type="application/json"
            id="perf-chart-data"
            set:html={JSON.stringify(chartConfig)}
          />
          <script>import '../scripts/perf-chart.ts';</script>
        </section>
      )
    }

    <section class="perf-method">
      <h2>How we measure</h2>
      <ul>
        <li>
          <strong>Hyperfine</strong> with 3 warmup runs and 10 timed runs per (fixture × tool × command)
          cell. Median latency reported.
        </li>
        <li>
          <strong>Peak RSS</strong> via <code>/usr/bin/time -v</code> on a single subsequent run.
        </li>
        <li>
          <strong>Fixtures</strong> are generated from
          <a href="https://github.com/FerrLabs/Fixtures">FerrLabs/Fixtures</a> with deterministic conventional-commit
          history (no flaky inputs).
        </li>
        <li>
          <strong>All commands</strong> are no-op-ish dry runs: <code>ferrflow check</code>,
          <code>semantic-release --dry-run --no-ci</code>, <code>changesets status</code>,
          <code>standard-version --dry-run</code>, etc. So we're comparing the planning cost, not
          the IO cost of actually mutating files.
        </li>
        <li>
          <strong>Single-threaded comparison.</strong> FerrFlow runs with <code>--jobs 1</code> in the
          chart above, so it's measured like the single-threaded JS tools. Its real-world parallel numbers
          are reported separately.
        </li>
        <li>
          <strong>Reproducible</strong> — the full pipeline is in
          <a href="https://github.com/FerrLabs/Benchmarks">FerrLabs/Benchmarks</a>; results land as
          artifacts on every <code>main</code> push and in each release notes.
        </li>
      </ul>
    </section>

    {
      hasParallel && (
        <section class="perf-section">
          <h2>Parallel mode</h2>
          <p class="lead">
            The comparison pins FerrFlow to a single thread (<code>--jobs 1</code>) so it's
            apples-to-apples with the single-threaded JS tools. In real CI it uses every core —
            here's the same <code>release --dry-run</code> on all {runnerCores} cores of the
            benchmark runner.
          </p>
          <div class="perf-table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Fixture</th>
                  <th>1 thread</th>
                  <th class="is-ours">{runnerCores} cores</th>
                  <th>Speedup</th>
                </tr>
              </thead>
              <tbody>
                {parallelRows.map((row) => (
                  <tr>
                    <td>{FIXTURE_LABELS[row.fixture] ?? row.fixture}</td>
                    <td>{fmt(row.single)}</td>
                    <td class="is-ours">{fmt(row.parallel as Cell)}</td>
                    <td>{speedup(row.single, row.parallel)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      hasInstallSizes && (
        <section class="perf-section">
          <h2>Install footprint</h2>
          <p class="perf-footprint-lead">
            Disk size after install. <code>release-please</code> appears here only — its runtime
            can't be benched offline (it needs the GitHub API to resolve the latest release), so
            footprint is the fair comparison we can publish.
          </p>
          <div class="perf-table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tool</th>
                  <th>npm install</th>
                  <th>Native binary</th>
                </tr>
              </thead>
              <tbody>
                {installSizeTools.map((tool) => (
                  <tr>
                    <th class="fix-label">{tool}</th>
                    <td class:list={{ 'is-ours': tool === 'ferrflow' }}>
                      <span class="lat">{fmtSize(installSizes[tool].npm)}</span>
                    </td>
                    <td class:list={{ 'is-ours': tool === 'ferrflow' }}>
                      <span class="lat">{fmtSize(installSizes[tool].binary)}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    <section class="perf-footnote">
      <h2>Why FerrFlow ships smaller numbers</h2>
      <ul>
        <li>
          <strong>Native binary.</strong> No Node.js boot, no npm install, no plugin discovery. A <code
            >ferrflow check</code
          > on a 50-package monorepo finishes before
          <code>node --version</code> would have warmed up.
        </li>
        <li>
          <strong>libgit2 in-process.</strong> Tag enumeration and commit walking happen via libgit2 in
          the same process. Competitors shell out to <code>git</code> per call; process-spawn overhead
          dominates on dense histories.
        </li>
        <li>
          <strong>Single tool, not a plugin tree.</strong> semantic-release pulls a chain of analyzers,
          notes generators, npm publishers and changelog writers — each with its own require() cost. FerrFlow's
          pipeline is one Rust crate.
        </li>
      </ul>
      <p class="cta">
        Numbers updating every release. See the
        <a href="https://github.com/FerrLabs/FerrFlow/releases/latest">latest release notes</a>
        for the full table including baseline delta.
      </p>
    </section>
  </main>

  <style>
    .perf-main {
      max-width: 1080px;
      margin: 0 auto;
      padding: 64px 24px 96px;
      color: #1e293b;
    }
    .perf-header {
      margin-bottom: 56px;
    }
    .eyebrow {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #64748b;
      margin: 0 0 12px;
    }
    h1 {
      font-size: clamp(40px, 5vw, 64px);
      line-height: 1.05;
      letter-spacing: -0.025em;
      margin: 0 0 20px;
      font-weight: 700;
    }
    h1 em {
      font-style: italic;
      color: #e8733a;
      font-weight: 600;
    }
    .lead {
      font-size: 18px;
      line-height: 1.55;
      color: #475569;
      max-width: 680px;
    }
    .lead a {
      color: #b8470f;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
    .updated {
      margin-top: 20px;
      font-size: 13px;
      color: #64748b;
    }
    .updated code {
      font-size: 12px;
      background: #f1f5f9;
      padding: 2px 6px;
      border-radius: 3px;
      color: #1e293b;
    }
    .perf-note {
      padding: 18px 22px;
      background: #fef3c7;
      border-left: 3px solid #f59e0b;
      border-radius: 4px;
      font-size: 14px;
      color: #78350f;
      margin: 0 0 48px;
    }
    .perf-note a {
      color: #b45309;
      font-weight: 600;
    }
    .perf-method,
    .perf-footnote {
      margin-bottom: 56px;
    }
    .perf-method h2,
    .perf-section h2,
    .perf-footnote h2 {
      font-size: 24px;
      letter-spacing: -0.015em;
      font-weight: 700;
      margin: 0 0 18px;
    }
    .perf-method h2 code,
    .perf-section h2 code,
    .perf-footnote h2 code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 20px;
      background: #fef3ec;
      color: #b8470f;
      padding: 2px 10px;
      border-radius: 4px;
    }
    .perf-method ul,
    .perf-footnote ul {
      padding-left: 20px;
      margin: 0 0 16px;
    }
    .perf-method li,
    .perf-footnote li {
      margin-bottom: 10px;
      line-height: 1.6;
      color: #334155;
    }
    .perf-method code,
    .perf-footnote code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 13px;
      background: #f1f5f9;
      padding: 1px 5px;
      border-radius: 3px;
      color: #1e293b;
    }
    .perf-method a,
    .perf-footnote a {
      color: #b8470f;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }
    .perf-section {
      margin-bottom: 40px;
    }
    .perf-footprint-lead {
      font-size: 14px;
      line-height: 1.55;
      color: #475569;
      margin: 0 0 16px;
      max-width: 720px;
    }
    .perf-footprint-lead code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      background: #f1f5f9;
      padding: 1px 5px;
      border-radius: 3px;
      color: #1e293b;
    }
    .perf-table-wrap {
      overflow-x: auto;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    thead th {
      text-align: left;
      padding: 12px 14px;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      font-weight: 600;
      color: #475569;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      letter-spacing: 0.02em;
    }
    thead th.is-ours {
      color: #e8733a;
    }
    tbody th.fix-label {
      text-align: left;
      padding: 12px 14px;
      font-weight: 500;
      color: #1e293b;
      border-bottom: 1px solid #f1f5f9;
      white-space: nowrap;
    }
    tbody td {
      padding: 12px 14px;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: top;
    }
    tbody tr:last-child th,
    tbody tr:last-child td {
      border-bottom: none;
    }
    tbody td.is-ours {
      background: rgba(232, 115, 58, 0.06);
    }
    tbody td.is-empty {
      color: #94a3b8;
    }
    .lat {
      display: block;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-weight: 600;
      color: #1e293b;
    }
    td.is-ours .lat {
      color: #b8470f;
    }
    .mem {
      display: block;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      color: #94a3b8;
      margin-top: 2px;
    }
    .cta {
      margin-top: 12px;
      font-size: 14px;
      color: #475569;
    }
    .cta a {
      color: #b8470f;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    @media (max-width: 720px) {
      .perf-main {
        padding: 48px 16px 64px;
      }
      table {
        font-size: 13px;
      }
      thead th,
      tbody th.fix-label,
      tbody td {
        padding: 10px 8px;
      }
    }
  </style>

  <style is:global>
    .perf-chart {
      margin-bottom: 56px;
    }
    .perf-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 16px;
    }
    .perf-pill {
      font-family: inherit;
      font-size: 14px;
      padding: 6px 14px;
      border-radius: 999px;
      border: 1px solid #e2e8f0;
      background: #fff;
      color: #475569;
      cursor: pointer;
      transition:
        border-color 0.12s,
        background 0.12s,
        color 0.12s;
    }
    .perf-pill:hover {
      border-color: #cbd5e1;
    }
    .perf-pill.is-active {
      border-color: #e8733a;
      background: rgba(232, 115, 58, 0.1);
      color: #e8733a;
      font-weight: 500;
    }
    .perf-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 14px;
      font-size: 12px;
      color: #64748b;
    }
    .perf-leg {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .perf-leg-dot {
      width: 10px;
      height: 10px;
      border-radius: 2px;
      display: inline-block;
    }
    .perf-canvas-wrap {
      position: relative;
      width: 100%;
      height: 380px;
    }
    .perf-chart-note {
      font-size: 12px;
      color: #94a3b8;
      margin: 16px 0 0;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>
</Layout>
