---
import Layout from './Layout.astro';
import type { Lang } from '../i18n/translations';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  canonical?: string;
  pathname?: string;
  lastUpdated: string;
  draft?: boolean;
}

const { title, description, lang, canonical, pathname = '/', lastUpdated, draft } = Astro.props;
const locale = lang === 'fr' ? 'fr-FR' : 'en-US';
const lastUpdatedFmt = new Date(lastUpdated).toLocaleDateString(locale, {
  day: 'numeric', month: 'long', year: 'numeric',
});
const eyebrow = lang === 'fr' ? 'Document légal' : 'Legal document';
const updatedLabel = lang === 'fr' ? 'Dernière mise à jour' : 'Last updated';
---
<Layout title={title} description={description} lang={lang} canonical={canonical} pathname={pathname}>
  <main class="legal-main">
    {draft && (
      <div class="legal-draft">
        <strong>{lang === 'fr' ? 'Brouillon' : 'Draft'}</strong> — {lang === 'fr'
          ? 'texte initial, en cours de validation juridique. Les clauses peuvent évoluer.'
          : 'initial text, undergoing legal review. Clauses may change.'}
      </div>
    )}
    <header class="legal-header">
      <p class="mono legal-eyebrow">{eyebrow}</p>
      <h1 class="legal-title"><slot name="heading">{title}</slot></h1>
      <p class="mono legal-meta">{updatedLabel}: {lastUpdatedFmt}</p>
    </header>
    <article class="legal-prose">
      <slot />
    </article>
  </main>
</Layout>

<style is:global>
  .legal-main { max-width: 760px; margin: 0 auto; padding: 64px 24px 96px; }
  .legal-draft {
    margin-bottom: 32px; padding: 14px 18px;
    background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.4);
    border-radius: 10px; font-family: var(--font-mono); font-size: 12px;
    line-height: 1.55; color: var(--fg-2);
  }
  .legal-draft strong {
    color: #b45309; font-family: var(--font-serif); font-style: italic;
    font-size: 14px; text-transform: none; letter-spacing: 0;
  }
  .legal-header { margin: 24px 0 56px; }
  .legal-eyebrow {
    font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase;
    color: var(--fg-3); margin: 0 0 14px;
  }
  .legal-title {
    font-family: var(--font-serif); font-weight: 700; line-height: 0.96;
    letter-spacing: -0.025em; color: var(--fg);
    font-size: clamp(40px, 6vw, 60px); margin: 0;
  }
  .legal-title em { font-style: italic; color: var(--accent); font-weight: 400; }
  .legal-meta {
    font-size: 11px; letter-spacing: 0.18em; color: var(--fg-3); margin-top: 14px;
  }
  .legal-prose { color: var(--fg-2); font-size: 15px; line-height: 1.7; }
  .legal-prose h2 {
    font-family: var(--font-serif); font-size: 26px; font-weight: 700;
    color: var(--fg); letter-spacing: -0.02em; margin: 48px 0 16px; line-height: 1.25;
  }
  .legal-prose h3 {
    font-family: var(--font-serif); font-size: 18px; font-weight: 600;
    color: var(--fg); margin: 32px 0 12px;
  }
  .legal-prose p, .legal-prose ul, .legal-prose ol { margin: 0 0 16px; }
  .legal-prose ul, .legal-prose ol { padding-left: 22px; }
  .legal-prose li { margin-bottom: 6px; }
  .legal-prose strong { color: var(--fg); font-weight: 600; }
  .legal-prose a {
    color: var(--accent); text-decoration: underline;
    text-decoration-thickness: 1px; text-underline-offset: 3px;
  }
  .legal-prose a:hover { text-decoration-thickness: 2px; }
  .legal-prose code {
    font-family: var(--font-mono); font-size: 0.92em;
    background: rgba(30, 41, 59, 0.06); padding: 1px 6px; border-radius: 4px;
  }
  .legal-prose .placeholder {
    background: rgba(245, 158, 11, 0.18); border-bottom: 1px dashed rgba(180, 83, 9, 0.6);
    padding: 0 4px; font-family: var(--font-mono); font-size: 12px;
    color: #92400e; border-radius: 2px;
  }
  .legal-prose table {
    width: 100%; border-collapse: collapse; font-size: 13px; margin: 0 0 20px;
  }
  .legal-prose th {
    text-align: left; padding: 10px 12px; font-family: var(--font-mono);
    font-size: 10px; letter-spacing: 0.18em; color: var(--fg-3);
    text-transform: uppercase; border-bottom: 1px solid var(--rule);
    background: rgba(30, 41, 59, 0.04);
  }
  .legal-prose td {
    padding: 10px 12px; border-bottom: 1px solid var(--rule); vertical-align: top;
  }
</style>
