---
import type { Props as StarlightProps } from '@astrojs/starlight/props';
import Search from '@astrojs/starlight/components/Search.astro';
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import VersionSelect from 'starlight-versions/components/VersionSelect.astro';
import SharedNavbar from '@ferrlabs/ui-astro/Navbar.astro';
import type { Lang } from '../i18n/translations';

const lang: Lang = Astro.url.pathname.startsWith('/fr/') ? 'fr' : 'en';

const currentPath = Astro.url.pathname;
const enEquiv = currentPath.startsWith('/fr/')
  ? currentPath.slice(3) || '/'
  : currentPath === '/fr'
    ? '/'
    : currentPath;
const frEquiv = enEquiv === '/' ? '/fr/' : `/fr${enEquiv.startsWith('/') ? '' : '/'}${enEquiv}`;
---

<div class="docs-header">
  {
    /* `hideLanguageToggle` suppresses the shared Navbar's own switcher so
      Starlight's native `<LanguageSelect />` (passed through the default
      slot below) takes over — Starlight resolves the localised URL of
      the current docs page via its route context, which a manual toggle
      can't see. */
  }
  {
    /* Standard (non-editorial) Navbar mode — keeps the search/version/lang
      slots that editorial mode drops. The brand mark is provided via
      logoSrc since the standard branch of @ferrlabs/ui-astro/Navbar.astro
      doesn't honor a `logo` slot. */
  }
  <SharedNavbar
    lang={lang}
    currentProduct="ferrflow"
    accent="orange"
    brand={{
      name: 'ferrflow',
      href: lang === 'fr' ? '/fr/' : '/',
      logoSrc: '/brand-mark.svg',
    }}
    links={[]}
    activePage="docs"
    hideLanguageToggle
    enEquiv={enEquiv}
    frEquiv={frEquiv}
  >
    {
      /* Default slot — rendered LEFT of the (hidden) LanguageSelect + CTA.
        VersionSelect is Starlight-specific; LanguageSelect is the native
        Starlight one which knows per-doc localisation. */
    }
    <div class="docs-controls">
      <VersionSelect />
      <LanguageSelect {...Astro.props as StarlightProps} />
    </div>
    {
      /* Centered search trigger. Starlight's Search owns its own modal +
        Ctrl/Cmd+K keyboard shortcut; we just relocate its trigger to the
        visual middle of the header for the usual docs affordance. */
    }
    <div slot="center" class="docs-center">
      <Search {...Astro.props as StarlightProps} />
    </div>
  </SharedNavbar>
</div>

<style>
  .docs-header {
    display: flex;
    align-items: center;
    height: 100%;
    width: 100%;
  }

  .docs-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .docs-center {
    width: clamp(18rem, 32vw, 28rem);
  }

  /* Below md (768px) Starlight ships its own hamburger that opens a
   * sidebar with search + nav + lang + version selects. Hide the
   * duplicates we surface in the desktop header — they overflow the
   * viewport and are already reachable from the Starlight menu. */
  @media (max-width: 767.98px) {
    .docs-controls,
    .docs-center {
      display: none;
    }
  }
</style>

<style is:global>
  /* Scope to .docs-center so we don't affect Starlight's default Search
     rendering anywhere else (mobile menu sidebar, etc.). `is:global`
     because <site-search> is a custom element Starlight renders as a
     direct child — Astro's default scoped styles wouldn't reach it. */
  .docs-center site-search {
    width: 100%;
  }
  .docs-center site-search button[data-open-modal] {
    width: 100%;
    min-height: 2.5rem;
    padding: 0.5rem 0.875rem;
    font-size: 0.95rem;
    gap: 0.625rem;
  }
  .docs-center site-search button[data-open-modal] svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  /* The Ctrl+K hint lives inside a <kbd> — bump it too so it stays
     proportional to the enlarged button. */
  .docs-center site-search button[data-open-modal] kbd {
    font-size: 0.8rem;
    padding: 0.15rem 0.4rem;
  }
</style>
