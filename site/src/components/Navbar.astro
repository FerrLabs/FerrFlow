---
import type { Lang } from '../i18n/translations';
import { t, getLocalizedPath } from '../i18n/translations';

interface Props {
  lang: Lang;
  activePage?: 'home' | 'docs';
  accent?: string; // CSS color for "Flow" text and logo tint
  /**
   * Skip rendering the FR/EN toggle built into this navbar. Used by the
   * docs Header, which renders Starlight's native `<LanguageSelect />` in
   * the `docs-controls` slot — Starlight knows the localised URL for the
   * current docs page, which the manual toggle can't resolve without
   * maintaining its own route table.
   */
  hideLanguageToggle?: boolean;
}

const { lang, activePage = 'home', accent, hideLanguageToggle = false } = Astro.props;

const docsPath = getLocalizedPath('/docs/introduction', lang);
const accentColor = accent || '#e8733a';
const headerBg = accent === '#6366F1' ? 'rgba(238,242,255,0.9)'
              : accent === '#10B981' ? 'rgba(236,253,245,0.9)'
              :                        'rgba(255,248,242,0.9)';
const headerBorder = accent === '#6366F1' ? '#E0E7FF'
                   : accent === '#10B981' ? '#D1FAE5'
                   :                        '#ffe8d2';
const logoFilter = accent === '#6366F1' ? 'hue-rotate(230deg) saturate(1.5)'
                 : accent === '#10B981' ? 'hue-rotate(140deg) saturate(1.2)'
                 :                        'none';
const navText = accent === '#6366F1' ? '#4338CA'
              : accent === '#10B981' ? '#065F46'
              :                        '#6b270e';
const navTextHover = accent === '#6366F1' ? '#1E1B4B'
                   : accent === '#10B981' ? '#064E3B'
                   :                        '#2d1b0e';
const navFerr = accent === '#6366F1' ? '#1E1B4B'
              : accent === '#10B981' ? '#064E3B'
              :                        '#2d1b0e';
// Compute localised siblings for the <select> options. Docs pages and
// home have parity across both languages. /cli also has an FR mirror.
const currentPath = Astro.url.pathname;
const enEquiv = currentPath.startsWith('/fr/')
  ? currentPath.slice(3) || '/'
  : currentPath === '/fr'
    ? '/'
    : currentPath;
const frEquiv = enEquiv === '/' ? '/fr/' : `/fr${enEquiv.startsWith('/') ? '' : '/'}${enEquiv}`;

// Paths that have a FR mirror today. Keep it small + explicit — adding a
// new FR page is a two-step (create `src/pages/fr/<page>.astro`, add it
// here). The selector still renders on all pages; the Français option is
// rendered disabled when this returns false.
const FR_AVAILABLE_RE = /^\/(?:fr\/)?(?:$|docs(?:$|\/)|cli(?:$|\/))/;
const hasAltTranslation = FR_AVAILABLE_RE.test(currentPath);
---

<div class="navbar" id="navbar-root" data-accent={accentColor} data-header-bg={headerBg} data-header-border={headerBorder} data-logo-filter={logoFilter} style={`--nav-text: ${navText}; --nav-text-hover: ${navTextHover}; --nav-ferr: ${navFerr};`}>
  <div class="navbar-left">
    <a href={lang === 'en' ? '/' : '/fr/'} class="navbar-logo">
      <svg class="navbar-logo-img" id="logo-icon" width="28" height="28" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-label="FerrFlow Logo">
        <circle cx="16" cy="16" r="4" fill="currentColor"/>
        <circle cx="16" cy="16" r="8" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.7"/>
        <circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="1" fill="none" opacity="0.4"/>
      </svg>
      <span class="navbar-logo-text">
        Ferr<span class="navbar-logo-highlight" id="logo-flow">Flow</span>
      </span>
    </a>
    <script is:inline>
      (function() {
        var nav = document.getElementById('navbar-root');
        var flow = document.getElementById('logo-flow');
        var icon = document.getElementById('logo-icon');
        if (!nav || !flow) return;

        var accent = nav.dataset.accent || '#e8733a';
        var headerBg = nav.dataset.headerBg || 'rgba(255,248,242,0.9)';
        var headerBorder = nav.dataset.headerBorder || '#ffe8d2';
        var logoFilter = nav.dataset.logoFilter || 'none';

        // Previous values
        var prevAccent = localStorage.getItem('ferrflow-accent') || '#e8733a';
        var prevBg = localStorage.getItem('ferrflow-header-bg') || 'rgba(255,248,242,0.9)';
        var prevBorder = localStorage.getItem('ferrflow-header-border') || '#ffe8d2';
        var prevFilter = localStorage.getItem('ferrflow-logo-filter') || 'none';

        var same = prevAccent === accent;

        // Flow text transition
        flow.style.setProperty('--prev-accent', prevAccent);
        flow.style.setProperty('--accent', accent);
        if (same) flow.classList.add('no-transition');

        // Header background transition
        var header = nav.closest('.landing-header');
        if (header) {
          header.style.setProperty('--prev-bg', prevBg);
          header.style.setProperty('--bg', headerBg);
          header.style.setProperty('--prev-border', prevBorder);
          header.style.setProperty('--border', headerBorder);
          if (same) header.classList.add('no-transition');
        }

        // Logo icon color transition
        if (icon) {
          icon.style.setProperty('--icon-color', prevAccent);
          if (same) {
            icon.classList.add('no-transition');
            icon.style.setProperty('--icon-color', accent);
          } else {
            requestAnimationFrame(function() {
              requestAnimationFrame(function() {
                icon.style.setProperty('--icon-color', accent);
              });
            });
          }
        }

        // Save current
        localStorage.setItem('ferrflow-accent', accent);
        localStorage.setItem('ferrflow-header-bg', headerBg);
        localStorage.setItem('ferrflow-header-border', headerBorder);
        localStorage.setItem('ferrflow-logo-filter', logoFilter);
      })();
    </script>

    <nav class="navbar-links">
      <a href="/cli" class="navbar-link">CLI</a>
      {activePage !== 'docs' && (
        <a href={docsPath} class="navbar-link">{t(lang, 'nav.docs')}</a>
      )}
    </nav>
  </div>

  {/* Absolutely centered so the slot sits in the visual middle of the
      header regardless of how wide the left/right clusters grow. Empty
      when no `center` slot content is provided (landing pages), which
      means zero layout cost on marketing. */}
  <div class="navbar-center">
    <slot name="center" />
  </div>

  <div class="navbar-right">
  <!--
    Slot receives the children passed from `Header.astro` when the navbar is
    used inside the Starlight docs shell — typically `<VersionSelect />` and
    `<Search />`. On landing pages no children are passed, so the slot is a
    no-op. Keep this near the top of `.navbar-right` so the version/search
    controls sit left of the language/auth/GitHub buttons.
  -->
  <slot />
  {!hideLanguageToggle && (
    /*
     * Visually identical to Starlight's <LanguageSelect /> (same icons,
     * same sizing, same padding logic) but wired to the marketing
     * navbar's color palette via --nav-text. Keeps the two surfaces
     * consistent without routing marketing pages through Starlight.
     *
     * Icon SVGs are copied verbatim from
     * `@astrojs/starlight/components-internals/Icons.ts`
     * (`translate` + `down-caret`) so visual parity stays guaranteed
     * on Starlight upgrades — we just re-sync the paths.
     *
     * Always rendered so readers know the site is multilingual. The
     * Français option is disabled (greyed out natively by the browser)
     * on paths without a FR mirror yet — see `FR_AVAILABLE_RE` above.
     * `hideLanguageToggle` suppresses the whole control (docs pass it
     * so Starlight's native <LanguageSelect /> takes over).
     */
    <label class="navbar-lang-select" style="--sl-select-width: 7em;">
      <span class="sr-only">Language</span>
      <svg class="navbar-lang-select-icon navbar-lang-select-label-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M8.516 3a.94.94 0 0 0-.941.94v1.15H2.94a.94.94 0 1 0 0 1.882h7.362a7.422 7.422 0 0 1-1.787 3.958 7.42 7.42 0 0 1-1.422-2.425.94.94 0 1 0-1.774.627 9.303 9.303 0 0 0 1.785 3.043 7.422 7.422 0 0 1-4.164 1.278.94.94 0 1 0 0 1.881 9.303 9.303 0 0 0 5.575-1.855 9.303 9.303 0 0 0 4.11 1.74l-.763 1.525a.968.968 0 0 0-.016.034l-1.385 2.77a.94.94 0 1 0 1.683.841l1.133-2.267h5.806l1.134 2.267a.94.94 0 0 0 1.683-.841l-1.385-2.769a.95.95 0 0 0-.018-.036l-3.476-6.951a.94.94 0 0 0-1.682 0l-1.82 3.639a7.423 7.423 0 0 1-3.593-1.256 9.303 9.303 0 0 0 2.27-5.203h1.894a.94.94 0 0 0 0-1.881H9.456V3.94A.94.94 0 0 0 8.516 3Zm6.426 11.794a1.068 1.068 0 0 1-.02.039l-.703 1.407h3.924l-1.962-3.924-1.24 2.478Z" clip-rule="evenodd"/>
      </svg>
      <select id="lang-switcher" autocomplete="off">
        <option value={enEquiv} selected={lang === 'en'}>English</option>
        <option value={frEquiv} selected={lang === 'fr'} disabled={!hasAltTranslation}>
          {hasAltTranslation ? 'Français' : 'Français (soon)'}
        </option>
      </select>
      <svg class="navbar-lang-select-icon navbar-lang-select-caret" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1.002 1.002 0 0 0 1.42 0L17 10.59a1.002 1.002 0 0 0 0-1.42Z"/>
      </svg>
    </label>
  )}
  <a href="https://app.ferrflow.com/login" class="navbar-signin">
    {t(lang, 'nav.signin')}
  </a>
  <a href="https://app.ferrflow.com/register" class="navbar-signup">
    {t(lang, 'nav.signup')}
  </a>
  <a
    href="https://github.com/FerrLabs/FerrFlow"
    class="navbar-github"
    aria-label="GitHub"
  >
    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
    </svg>
  </a>
  </div>
</div>

<script>
  const wrap = document.getElementById('products-dropdown');
  const menu = document.getElementById('products-menu');
  if (wrap && menu) {
    wrap.addEventListener('mouseenter', () => menu.classList.add('open'));
    wrap.addEventListener('mouseleave', () => menu.classList.remove('open'));
    wrap.querySelector('button')?.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('open');
    });
    document.addEventListener('click', () => menu.classList.remove('open'));
  }

  // Native <select>-based language switcher — matches Starlight's docs
  // selector pattern. On change, navigate to the chosen locale's URL. The
  // option values are full paths (computed server-side via the
  // FR_AVAILABLE_RE map), so client code stays trivial.
  const langSelect = document.getElementById('lang-switcher') as HTMLSelectElement | null;
  langSelect?.addEventListener('change', () => {
    const target = langSelect.value;
    if (target && target !== window.location.pathname) {
      // Preserve the locale preference so future first visits land in the
      // right language. The i18n helper stores it in localStorage.
      const inferredLang = target.startsWith('/fr') ? 'fr' : 'en';
      const saveLang = (window as any).__saveLang as ((l: string) => void) | undefined;
      if (saveLang) saveLang(inferredLang);
      window.location.assign(target);
    }
  });

</script>

<style>
  .navbar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
  }

  .navbar-left {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* Absolutely centered so the content sits in the visual middle of the
     header regardless of the left/right cluster widths. Flush-collapses
     on narrow viewports (pointer-events none on the empty wrapper so it
     never blocks clicks). */
  .navbar-center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  .navbar-center > * {
    pointer-events: auto;
  }
  @media (max-width: 900px) {
    /* Small viewports: drop back into flow at the right edge so the
       centered element doesn't overlap the logo / right cluster. Same
       visual outcome as the original layout there. */
    .navbar-center {
      position: static;
      transform: none;
    }
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .navbar-logo-img {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--icon-color, #e8733a);
    transition: color 0.9s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .navbar-logo-img.no-transition {
    transition: none;
  }

  .navbar-logo-text {
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--nav-ferr, #2d1b0e);
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .navbar-logo-highlight {
    --fill: 0%;
    background: radial-gradient(ellipse at 15% 25%, var(--accent, #e8733a) 0%, var(--accent, #e8733a) var(--fill), var(--prev-accent, #e8733a) var(--fill), var(--prev-accent, #e8733a) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: blob-fill 0.9s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .navbar-logo-highlight.no-transition {
    --fill: 100%;
    animation: none;
  }

  @keyframes blob-fill {
    0%   { --fill: 0%; }
    100% { --fill: 200%; }
  }

  @property --fill {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }

  .navbar-links {
    display: none;
    align-items: center;
    gap: 1.75rem;
    font-size: 0.85rem;
  }

  @media (min-width: 640px) {
    .navbar-links { display: flex; }
  }

  .navbar-link {
    color: var(--nav-text, #6b270e);
    text-decoration: none;
    transition: color 0.15s;
  }

  .navbar-link:hover { color: var(--nav-text-hover, #2d1b0e); }

  .navbar-dropdown { position: relative; }

  .navbar-dropdown-btn {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--nav-text, #6b270e);
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.85rem;
    font-family: inherit;
    padding: 0.25rem 0;
  }

  .navbar-dropdown-btn:hover { color: var(--nav-text-hover, #2d1b0e); }

  .navbar-dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 0.75rem);
    left: -0.5rem;
    width: 380px;
    background: white;
    border: 1px solid #f0e0d0;
    border-radius: 0.875rem;
    box-shadow: 0 16px 48px rgba(45, 27, 14, 0.1), 0 2px 8px rgba(45, 27, 14, 0.06);
    padding: 0.375rem;
    z-index: 100;
  }

  .navbar-dropdown-menu::before {
    content: '';
    position: absolute;
    top: -1rem;
    left: -1rem;
    right: -1rem;
    height: 1.5rem;
  }

  .navbar-dropdown-menu.open { display: block; }

  .navbar-dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem 0.875rem;
    border-radius: 0.625rem;
    text-decoration: none;
    transition: background 0.15s;
  }

  .navbar-dropdown-item--orange:hover { background: #FFF8F2; }
  .navbar-dropdown-item--indigo:hover { background: #EEF2FF; }
  .navbar-dropdown-item--emerald:hover { background: #ECFDF5; }

  .navbar-dropdown-icon {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.625rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .navbar-dropdown-name { font-weight: 700; font-size: 0.85rem; line-height: 1.2; }
  .navbar-dropdown-desc { font-size: 0.7rem; margin-top: 0.15rem; line-height: 1.3; }

  .navbar-github {
    color: var(--nav-ferr, #2d1b0e);
    text-decoration: none;
    transition: color 0.15s;
    display: flex;
    align-items: center;
  }

  .navbar-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .navbar-lang {
    color: var(--nav-text, #6b270e);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.15s;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    padding: 0;
  }

  .navbar-lang:hover { color: var(--nav-text-hover, #2d1b0e); }

  /* Mirrors Starlight's Select component geometry (same sizing vars,
     same absolute positioning, same padding math) so the marketing
     navbar picker and the docs navbar picker are visually identical. */
  .navbar-lang-select {
    --sl-label-icon-size: 0.875rem;
    --sl-caret-size: 1.25rem;
    --sl-inline-padding: 0.5rem;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--nav-text, #6b270e);
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.15s;
  }
  .navbar-lang-select:hover { color: var(--nav-text-hover, #2d1b0e); }

  .navbar-lang-select-icon {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .navbar-lang-select-label-icon {
    width: var(--sl-label-icon-size);
    height: var(--sl-label-icon-size);
    inset-inline-start: 0;
  }
  .navbar-lang-select-caret {
    width: var(--sl-caret-size);
    height: var(--sl-caret-size);
    inset-inline-end: 0;
  }

  .navbar-lang-select select {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    margin: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    text-overflow: ellipsis;
    padding-block: 0.375rem;
    padding-inline: calc(var(--sl-label-icon-size) + var(--sl-inline-padding) + 0.25rem)
                     calc(var(--sl-caret-size) + var(--sl-inline-padding) + 0.25rem);
    margin-inline: calc(var(--sl-inline-padding) * -1);
    width: calc(var(--sl-select-width, 7em) + var(--sl-inline-padding) * 2);
  }
  .navbar-lang-select select:focus-visible {
    outline: 2px solid var(--nav-text-hover, #2d1b0e);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Screen-reader-only utility to mirror Starlight's .sr-only usage on
     the "Language" label — we can't rely on Starlight's CSS here. */
  .navbar-lang-select .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .navbar-github:hover { color: var(--nav-text, #6b270e); }

  .navbar-signin {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.6rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--nav-text, #6b270e);
    text-decoration: none;
    transition: color 0.15s;
  }

  .navbar-signin:hover {
    color: var(--nav-text-hover, #2d1b0e);
  }

  .navbar-signup {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    background: var(--nav-ferr, #2d1b0e);
    text-decoration: none;
    transition: background 0.15s, transform 0.15s;
  }

  .navbar-signup:hover {
    background: var(--nav-text, #6b270e);
    transform: translateY(-1px);
  }
</style>
